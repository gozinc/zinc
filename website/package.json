{
  "name": "zinc-docs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force",
    "build:brand": "node scripts/build-brand.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:examples": "node scripts/check-go-examples.mjs",
    "check:links": "node scripts/check-built-links.mjs",
    "check:site": "npm run check:docs && npm run build && npm run check:links",
    "check:templ": "node scripts/check-templ-example.mjs",
    "preview:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.3.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "wrangler": "4.138.0"
  }
}
