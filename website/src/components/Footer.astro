---
import Default from "@astrojs/starlight/components/Footer.astro";
import type { Props } from "@astrojs/starlight/props";

const props = Astro.props as Props;
const year = new Date().getFullYear();
const isHome = Astro.locals.starlightRoute.entry.id === "index";
---

<Default {...props} />

{!isHome && (
<footer class="z-doc-footer">
  <span><span class="z-doc-footer-element" aria-hidden="true">Zn · 30 · 65.38</span> Maintained by Carbon Software Ltd. © 2024–{year} Matt J. Stevenson and contributors.</span>
  <nav aria-label="Project links">
    <a href="https://github.com/0mjs/zinc">GitHub</a>
    <a href="https://pkg.go.dev/github.com/0mjs/zinc">pkg.go.dev</a>
    <a href="https://github.com/0mjs/zinc/blob/dev/LICENSE">MIT License</a>
  </nav>
</footer>
)}
