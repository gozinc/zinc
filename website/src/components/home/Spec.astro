---
// An inspection certificate for one endpoint. Galvanized steel ships with a
// 3.1 certificate: what was specified, and what was tested. A Zinc app's
// OpenAPI 3.1 spec is the same promise. Each row ties a line of the code to
// what /openapi.json states and to what Zinc did with a real request that
// broke it. Every request and response here is from a real run.

interface Row {
  k: string; // the token in the specimen it comes from
  property: string;
  code: string;
  spec: string;
  request: string;
  response: string;
  status: number;
}

const rows: Row[] = [
  {
    k: "org",
    property: "org",
    code: 'path:"org"',
    spec: "path parameter · string · required",
    request: "POST /api/orgs/acme/users",
    response: '201 · "org_id":"acme"',
    status: 201,
  },
  {
    k: "dry",
    property: "dry_run",
    code: 'query:"dry_run"  bool',
    spec: "query parameter · boolean",
    request: "?dry_run=yes",
    response: '400 · "dry_run":"must be a boolean"',
    status: 400,
  },
  {
    k: "fmt",
    property: "email · format",
    code: 'validate:"…,email"',
    spec: 'format: "email"',
    request: '{"email":"nope"}',
    response: '422 · "email":"must be an email address"',
    status: 422,
  },
  {
    k: "req",
    property: "email · required",
    code: 'validate:"required,…"',
    spec: 'required: ["email"]',
    request: "{}",
    response: '422 · "email":"is required"',
    status: 422,
  },
  {
    k: "out",
    property: "success",
    code: "(User, error) · .Status(201)",
    spec: "201 → User",
    request: '{"email":"ada@example.com"}',
    response: '201 · {"id":1,"org_id":"acme",…}',
    status: 201,
  },
  {
    k: "err",
    property: "errors",
    code: "return err",
    spec: "400 · 422 · 500 → Error",
    request: '{"email":',
    response: '400 · "invalid request body"',
    status: 400,
  },
];
---

<section class="spec" data-spec>
  <header class="head">
    <div>
      <p class="kicker">OpenAPI 3.1 · built in</p>
      <h2>Your types, certified.</h2>
    </div>
    <div class="lede">
      <p>
        Galvanized steel ships with a 3.1 inspection certificate: what was specified, and what was
        tested. A Zinc app ships one too. Every app serves an OpenAPI 3.1 spec at <code>/openapi.json</code>
        and a reference page at <code>/docs</code>, built from the types you already wrote, and every rule
        the spec states is a rule Zinc checks on each request.
      </p>
      <p class="links">
        <a href="/guide/openapi/">OpenAPI guide →</a>
        <a href="/guide/coming-from-huma-or-fuego/">Coming from Huma or Fuego →</a>
      </p>
    </div>
  </header>

  <article class="cert" aria-label="An inspection certificate for POST /api/orgs/{org}/users">
    <i class="reg tl" aria-hidden="true"></i><i class="reg tr" aria-hidden="true"></i>
    <i class="reg bl" aria-hidden="true"></i><i class="reg br" aria-hidden="true"></i>

    <div class="bar">
      <span><b>Inspection certificate</b> · OpenAPI 3.1</span>
      <span class="no">No. POST /api/orgs/&#123;org&#125;/users</span>
    </div>

    <div class="top">
      <div class="specimen">
        <p class="label">Specimen · users.go</p>
        <pre data-specimen><span class="kw">type</span> <span class="ty">CreateUser</span> <span class="kw">struct</span> &#123;
    OrgID  <span class="ty">string</span> <span class="tok" data-k="org">`path:"org"`</span>
    DryRun <span class="ty">bool</span>   <span class="tok" data-k="dry">`query:"dry_run"`</span>
    Email  <span class="ty">string</span> <span class="st">`json:"email"</span> <span class="st">validate:"</span><span class="tok" data-k="req">required</span><span class="st">,</span><span class="tok" data-k="fmt">email</span><span class="st">"`</span>
&#125;

api.<span class="fn">Post</span>(<span class="st">"/orgs/&#123;org&#125;/users"</span>, zinc.<span class="fn">Typed</span>(<span class="tok" data-k="out">createUser</span>)).
    <span class="fn">Status</span>(http.StatusCreated)  <span class="cm">// errors go to the</span> <span class="tok" data-k="err">error handler</span></pre>
      </div>
      <dl class="issued">
        <div><dt>Issued by</dt><dd>zinc.New()</dd></div>
        <div><dt>Specified at</dt><dd><code>GET /openapi.json</code></dd></div>
        <div><dt>Rendered at</dt><dd><code>GET /docs</code></dd></div>
        <div><dt>Verified by</dt><dd><code>app.Validate()</code> → <code>nil</code></dd></div>
      </dl>
    </div>

    <div class="table" role="table" aria-label="Each property: the code, what the spec states, and a real request">
      <div class="tr th" role="row">
        <span role="columnheader">Property</span>
        <span role="columnheader">From your code</span>
        <span role="columnheader">Specified</span>
        <span role="columnheader">Tested with a real request</span>
        <span role="columnheader" class="res">Result</span>
      </div>
      {rows.map((r, i) => (
        <div class="tr" role="row" data-k={r.k} tabindex="0">
          <span role="cell" class="prop"><b class="n">3.1.{i + 1}</b>{r.property}</span>
          <span role="cell" class="code"><code>{r.code}</code></span>
          <span role="cell" class="specd">{r.spec}</span>
          <span role="cell" class="test">
            <code class="req">{r.request}</code>
            <code class={`resp s${Math.floor(r.status / 100)}`}>{r.response}</code>
          </span>
          <span role="cell" class="res"><b>✓</b> conforms</span>
        </div>
      ))}
    </div>

    <footer class="foot">
      <div class="seal" data-seal aria-label="Conforms">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <defs>
            <path id="seal-ring" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" />
          </defs>
          <circle cx="60" cy="60" r="56" class="rim" />
          <circle cx="60" cy="60" r="34" class="core" />
          <text class="ring"><textPath href="#seal-ring" startOffset="0">SPEC · ENFORCED · OPENAPI 3.1 · ZINC ·</textPath></text>
          <text x="60" y="57" class="big">Zn</text>
          <text x="60" y="72" class="small">CONFORMS</text>
        </svg>
      </div>
      <div class="remarks">
        <p class="label">Remarks</p>
        <p>
          A rule appears in the spec only when it's checked on requests; a rule nothing checks stops the
          route from registering. Routes OpenAPI can't tell apart, and examples of the wrong type, fail
          at startup. Zinc's spec output is audited in CI against 147 scenarios, real responses and a
          generated client.
        </p>
        <p class="out">Outside this certificate: YAML output and polymorphic (<code>oneOf</code>) types.</p>
      </div>
    </footer>
  </article>
</section>

<script>
  // A row and the code it comes from light up together, from either side.
  document.querySelectorAll<HTMLElement>("[data-spec]").forEach((root) => {
    const cert = root.querySelector<HTMLElement>(".cert")!;
    const parts = [...root.querySelectorAll<HTMLElement>("[data-k]")];
    const light = (k: string | null) => {
      parts.forEach((p) => p.classList.toggle("lit", k !== null && p.dataset.k === k));
      cert.classList.toggle("focus", k !== null);
    };
    parts.forEach((p) => {
      p.addEventListener("pointerenter", () => light(p.dataset.k ?? null));
      p.addEventListener("pointerleave", () => light(null));
      p.addEventListener("focus", () => light(p.dataset.k ?? null));
      p.addEventListener("blur", () => light(null));
    });

    // The seal is pressed when the certificate comes into view.
    const seal = root.querySelector<HTMLElement>("[data-seal]")!;
    if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      seal.classList.add("pressed");
      return;
    }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        seal.classList.add("pressed");
        io.disconnect();
      }
    }, { threshold: 0.6 });
    io.observe(seal);
  });
</script>

<style>
  .head {
    align-items: end;
    display: grid;
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    margin-bottom: 2rem;
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  h2 {
    color: var(--z-text);
    font: 600 clamp(1.9rem, 3.4vw, 2.6rem) / 1.08 var(--sl-font);
    letter-spacing: -0.035em;
    margin: 0;
    text-wrap: balance;
  }

  .lede p {
    color: var(--z-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0;
  }

  .lede code {
    color: var(--z-text);
    font-size: 0.86em;
  }

  .lede .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 1rem;
  }

  .links a {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .links a + a {
    color: var(--z-muted);
  }

  .links a:hover {
    color: var(--z-zn);
  }

  /* The certificate: a ruled sheet with registration marks. */
  .cert {
    background:
      repeating-linear-gradient(0deg, transparent 0 27px, color-mix(in srgb, var(--z-zn) 4%, transparent) 27px 28px),
      var(--z-panel);
    border: 1px solid color-mix(in srgb, var(--z-zn) 22%, transparent);
    border-radius: 4px;
    box-shadow: inset 0 0 0 5px var(--z-panel), inset 0 0 0 6px color-mix(in srgb, var(--z-zn) 14%, transparent);
    padding: 1.4rem 1.6rem 1.2rem;
    position: relative;
  }

  .reg {
    border-color: color-mix(in srgb, var(--z-zn) 45%, transparent);
    border-style: solid;
    height: 12px;
    position: absolute;
    width: 12px;
  }

  .reg.tl { border-width: 1px 0 0 1px; left: 12px; top: 12px; }
  .reg.tr { border-width: 1px 1px 0 0; right: 12px; top: 12px; }
  .reg.bl { border-width: 0 0 1px 1px; bottom: 12px; left: 12px; }
  .reg.br { border-width: 0 1px 1px 0; bottom: 12px; right: 12px; }

  .bar {
    border-bottom: 1px solid color-mix(in srgb, var(--z-zn) 22%, transparent);
    color: var(--z-muted);
    display: flex;
    flex-wrap: wrap;
    font: 400 0.72rem/1.4 var(--sl-font-mono);
    gap: 0.4rem 1rem;
    justify-content: space-between;
    letter-spacing: 0.04em;
    padding: 0 0.4rem 0.8rem;
    text-transform: uppercase;
  }

  .bar b {
    color: var(--z-text);
    font-weight: 600;
  }

  .bar .no {
    text-transform: none;
  }

  .label {
    color: var(--z-soft);
    font: 500 0.68rem/1 var(--sl-font-mono);
    letter-spacing: 0.06em;
    margin: 0 0 0.6rem;
    text-transform: uppercase;
  }

  .top {
    border-bottom: 1px solid color-mix(in srgb, var(--z-zn) 22%, transparent);
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    padding: 1.1rem 0.4rem;
  }

  .specimen pre {
    background: var(--z-plate);
    border: 1px solid var(--z-plate-line);
    border-radius: 6px;
    color: var(--z-plate-ink);
    font: var(--z-code-weight, 500) 0.8rem/1.6 var(--sl-font-mono);
    margin: 0;
    overflow-x: auto;
    padding: 0.85rem 1rem;
    tab-size: 4;
  }

  .kw { color: var(--z-code-kw); }
  .ty { color: var(--z-code-type); }
  .st { color: var(--z-code-str); }
  .fn { color: var(--z-code-fn); }
  .cm { color: #6c788e; font-style: italic; }

  .tok {
    border-radius: 3px;
    box-shadow: 0 0 0 1px transparent;
    color: var(--z-code-str);
    transition: background 0.15s, box-shadow 0.15s, color 0.15s;
  }

  .tok[data-k="out"],
  .tok[data-k="err"] {
    color: var(--z-plate-ink);
  }

  .tok[data-k="err"] {
    font-style: italic;
  }

  .tok.lit {
    background: color-mix(in srgb, var(--z-code-str) 18%, transparent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--z-code-str) 18%, transparent);
    color: #e7f2dc;
  }

  .issued {
    align-content: start;
    display: grid;
    gap: 0.75rem;
    margin: 1.4rem 0 0;
  }

  .issued div {
    border-bottom: 1px dashed color-mix(in srgb, var(--z-zn) 20%, transparent);
    display: grid;
    gap: 0.2rem;
    padding-bottom: 0.6rem;
  }

  .issued dt {
    color: var(--z-soft);
    font: 500 0.66rem/1 var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .issued dd {
    color: var(--z-text);
    font: 500 0.82rem/1.4 var(--sl-font-mono);
    margin: 0;
  }

  .issued code {
    color: inherit;
    font-size: 1em;
  }

  /* The results table. */
  .table {
    padding: 0.4rem 0;
  }

  .tr {
    align-items: baseline;
    border-bottom: 1px solid color-mix(in srgb, var(--z-zn) 10%, transparent);
    display: grid;
    gap: 0.4rem 1.1rem;
    grid-template-columns: 9.5rem minmax(0, 0.95fr) minmax(0, 1fr) minmax(0, 1.55fr) 6.5rem;
    padding: 0.7rem 0.4rem;
    transition: background 0.15s, opacity 0.15s;
  }

  .tr:focus-visible {
    outline: 1.5px solid var(--z-zn);
    outline-offset: -2px;
  }

  .th {
    color: var(--z-soft);
    font: 500 0.66rem/1.2 var(--sl-font-mono);
    letter-spacing: 0.06em;
    padding-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .cert.focus .tr:not(.th):not(.lit) {
    opacity: 0.45;
  }

  .tr.lit {
    background: var(--z-zn-soft);
  }

  .prop {
    color: var(--z-text);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .n {
    color: var(--z-soft);
    display: block;
    font: 500 0.66rem/1.6 var(--sl-font-mono);
  }

  .code code,
  .test code {
    font: 500 0.76rem/1.45 var(--sl-font-mono);
    overflow-wrap: anywhere;
  }

  .code code {
    color: var(--z-text);
  }

  .specd {
    color: var(--z-body);
    font: 400 0.78rem/1.45 var(--sl-font-mono);
  }

  .test {
    display: grid;
    gap: 0.2rem;
  }

  .test .req {
    color: var(--z-muted);
  }

  .test .req::before {
    content: "→ ";
    color: var(--z-soft);
  }

  .test .resp::before {
    content: "← ";
    color: var(--z-soft);
  }

  .resp.s2 { color: var(--z-tip); }
  .resp.s4 { color: var(--z-caution); }

  .res {
    color: var(--z-tip);
    font: 500 0.74rem/1.4 var(--sl-font-mono);
    text-align: right;
  }

  .th .res {
    color: var(--z-soft);
  }

  .res b {
    font-weight: 700;
  }

  /* The seal, struck in zinc, and the remarks. */
  .foot {
    align-items: center;
    border-top: 1px solid color-mix(in srgb, var(--z-zn) 22%, transparent);
    display: grid;
    gap: 1.5rem 2rem;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    padding: 1.2rem 0.4rem 0.2rem;
  }

  .seal {
    aspect-ratio: 1;
    background: #c9ced3 url("/zn-spangle-hd.webp") center / 220px auto;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5), 0 6px 18px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: rotate(-14deg) scale(1.25);
    transition: opacity 0.35s ease-out, transform 0.35s cubic-bezier(0.2, 1.4, 0.4, 1);
    width: 8.5rem;
  }

  .seal.pressed {
    opacity: 1;
    transform: rotate(-9deg) scale(1);
  }

  .seal svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .seal .rim {
    fill: none;
    stroke: rgba(21, 23, 26, 0.55);
    stroke-width: 1.2;
  }

  .seal .core {
    fill: none;
    stroke: rgba(21, 23, 26, 0.45);
    stroke-width: 1;
  }

  .seal .ring {
    fill: rgba(21, 23, 26, 0.78);
    font: 600 8.6px var(--sl-font-mono);
    letter-spacing: 0.2em;
  }

  .seal .big {
    fill: #15171a;
    font: 400 22px var(--z-font-display);
    text-anchor: middle;
  }

  .seal .small {
    fill: rgba(21, 23, 26, 0.85);
    font: 700 7.4px var(--sl-font-mono);
    letter-spacing: 0.18em;
    text-anchor: middle;
  }

  .remarks p {
    color: var(--z-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0;
    max-width: 72ch;
  }

  .remarks .label {
    margin-bottom: 0.5rem;
  }

  .remarks .out {
    color: var(--z-soft);
    font-size: 0.82rem;
    margin-top: 0.6rem;
  }

  .remarks code {
    font-size: 0.9em;
  }

  @media (max-width: 64rem) {
    .head,
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
    .issued {
      margin-top: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tr {
      grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1fr);
    }
    .tr .test {
      grid-column: 2 / 4;
    }
    .tr .res {
      grid-column: 1;
      grid-row: 2;
      text-align: left;
    }
    .th .test,
    .th .res {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .cert {
      padding: 1.1rem 0.9rem 1rem;
    }
    .issued {
      grid-template-columns: minmax(0, 1fr);
    }
    .th {
      display: none;
    }
    .tr {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }
    .tr .test,
    .tr .res {
      grid-column: auto;
      grid-row: auto;
    }
    .foot {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      align-items: start;
    }
    .seal {
      width: 6.5rem;
    }
  }
</style>
