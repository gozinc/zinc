---
// The OpenAPI section: one handler's code on a plate, and what each part of
// it becomes in the spec and on the wire. It's laid out like the request
// journey above, heading first, then the plate (on the left this time) and
// the parts to pick, the same height side by side. Every request
// and response is from a real run against Zinc.
import { Code } from "astro:components";
import zincFrost from "../../themes/zinc-frost.json";

const code = `type CreateUser struct {
	OrgID  string \`path:"org"\`
	DryRun bool   \`query:"dry_run"\`
	Email  string \`json:"email" validate:"required,email"\`
}

api.Post("/orgs/{org}/users", zinc.Typed(createUser)).
	Status(http.StatusCreated)`;

interface Line { dir: "in" | "out"; text: string }
interface Part {
  id: string;
  name: string;
  blurb: string;
  marks: number[]; // 1-based lines of the code it comes from
  spec: string;
  exchange: Line[];
}

const parts: Part[] = [
  {
    id: "path",
    name: "Path parameters",
    blurb: "A path tag is a required parameter, typed from its field.",
    marks: [2, 7],
    spec: "org · in: path · string · required",
    exchange: [
      { dir: "in", text: 'POST /api/orgs/acme/users  {"email":"ada@example.com"}' },
      { dir: "out", text: '201  {"id":1,"org_id":"acme","email":"ada@example.com"}' },
    ],
  },
  {
    id: "query",
    name: "Query parameters",
    blurb: "Parsed into the field's type; a value that won't parse is a 400 naming it.",
    marks: [3],
    spec: "dry_run · in: query · boolean",
    exchange: [
      { dir: "in", text: "POST /api/orgs/acme/users?dry_run=yes" },
      { dir: "out", text: '400  "dry_run": "must be a boolean"' },
    ],
  },
  {
    id: "validate",
    name: "Validation",
    blurb: "validate tags become schema keywords, and every request is checked against them.",
    marks: [4],
    spec: 'required: ["email"] · email: format: "email"',
    exchange: [
      { dir: "in", text: "{}" },
      { dir: "out", text: '422  "email": "is required"' },
      { dir: "in", text: '{"email":"nope"}' },
      { dir: "out", text: '422  "email": "must be an email address"' },
    ],
  },
  {
    id: "responses",
    name: "Responses and errors",
    blurb: "The return type is the 201 body; errors take your error handler's shape.",
    marks: [7, 8],
    spec: "201 → User · 400, 422, 500 → Error",
    exchange: [
      { dir: "in", text: '{"email":' },
      { dir: "out", text: '400  "invalid request body"' },
    ],
  },
];

const markLines = (lines: number[]) => ({
  line(this: any, node: any, line: number) {
    if (lines.includes(line)) this.addClassToHast(node, "mark");
  },
});
---

<section class="spec" data-spec>
  <div class="head">
    <p class="kicker">OpenAPI · built in</p>
    <h2>Your types are the spec.</h2>
    <p class="lede">
      Every app serves an OpenAPI 3.1 spec at <code>/openapi.json</code> and a reference page at <code>/docs</code>,
      built from the handlers you already wrote. A rule shows up in the spec only when Zinc checks it on requests.
    </p>
  </div>

  <div class="body">
    <div class="plate">
      <div class="bar">
        <span class="file">users.go</span>
        <span class="serves"><code>GET /openapi.json</code> · <code>GET /docs</code></span>
      </div>
      <div class="panes">
      {parts.map((p, i) => (
        <div class="pane" role="tabpanel" id={`spec-pane-${p.id}`} aria-labelledby={`spec-tab-${p.id}`} hidden={i !== 0}>
          <div class="code"><Code code={code.replace(/\t/g, "    ")} lang="go" theme={zincFrost as any} transformers={[markLines(p.marks)]} /></div>
          <p class="said"><span class="tag">In the spec</span><code>{p.spec}</code></p>
          <div class="exchange" aria-label="A real request and Zinc's response">
            {p.exchange.map((l) => (
              <p class={l.dir === "out" && !l.text.startsWith("2") ? "out err" : l.dir}><span class="dir" aria-hidden="true">{l.dir === "in" ? "→" : "←"}</span>{l.text}</p>
            ))}
          </div>
        </div>
      ))}
      </div>
    </div>

    <div class="copy">
      <p class="pick">Pick one to see it in the spec and on the wire.</p>
      <ul class="parts" role="tablist" aria-label="Parts of the handler" aria-orientation="vertical">
        {parts.map((p, i) => (
          <li role="tab" id={`spec-tab-${p.id}`} aria-controls={`spec-pane-${p.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-part={i}>
            <strong>{p.name}</strong>
            <span>{p.blurb}</span>
          </li>
        ))}
      </ul>
      <p class="links">
        <a href="/guide/openapi/">OpenAPI guide →</a>
        <a href="/guide/coming-from-huma-or-fuego/">Coming from Huma or Fuego →</a>
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-spec]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLElement>("[role=tab]")];
    const panes = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")];
    const select = (i: number, focus = false) => {
      const n = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        t.setAttribute("aria-selected", String(k === n));
        t.tabIndex = k === n ? 0 : -1;
      });
      panes.forEach((p, k) => (p.hidden = k !== n));
      if (focus) tabs[n].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step) {
          e.preventDefault();
          select(i + step, true);
        } else if (e.key === "Home" || e.key === "End") {
          e.preventDefault();
          select(e.key === "Home" ? 0 : tabs.length - 1, true);
        }
      });
    });
  });
</script>

<style>
  .body {
    align-items: stretch;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.78fr);
  }

  /* The parts fill the column, so it's as tall as the plate. */
  .copy {
    display: flex;
    flex-direction: column;
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  h2 {
    color: var(--z-text);
    font: 600 clamp(1.9rem, 3.4vw, 2.6rem) / 1.08 var(--sl-font);
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }

  .lede {
    color: var(--z-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0.9rem 0 2.25rem;
    max-width: 62ch;
  }

  .lede code {
    color: var(--z-text);
    font-size: 0.86em;
  }

  .pick {
    color: var(--z-soft);
    font: 400 0.72rem/1 var(--sl-font-mono);
    margin: 0 0 0.6rem;
  }

  .parts {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.2rem;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .parts li {
    border: 1px solid transparent;
    border-radius: 10px;
    color: var(--z-muted);
    cursor: pointer;
    display: grid;
    gap: 0.2rem;
    margin: 0 -0.7rem;
    outline: none;
    padding: 0.6rem 0.7rem 0.65rem;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .parts li:hover {
    background: color-mix(in srgb, var(--z-panel) 60%, transparent);
  }

  .parts li[aria-selected="true"] {
    background: var(--z-panel);
    border-color: var(--sl-color-hairline-light);
  }

  .parts li:focus-visible {
    border-color: var(--z-muted);
  }

  .parts strong {
    color: var(--z-body);
    font-size: 0.98rem;
    font-weight: 600;
  }

  .parts li[aria-selected="true"] strong {
    color: var(--z-text);
  }

  .parts span {
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin: 1.4rem 0 0;
  }

  .links a {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .links a + a {
    color: var(--z-muted);
  }

  .links a:hover {
    color: var(--z-zn);
  }

  /* The plate, the same as the request journey's. */
  .plate {
    --rule: #1f242a;
    background: var(--z-plate);
    border: 1px solid var(--rule);
    border-radius: 12px;
    color: var(--z-plate-ink);
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }

  .bar {
    align-items: baseline;
    background: var(--z-plate-bar);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    font: 400 0.74rem/1 var(--sl-font-mono);
    gap: 0.5rem 1rem;
    justify-content: space-between;
    padding: 0.8rem 1.1rem;
  }

  .file {
    color: #eceff4;
  }

  .serves {
    color: var(--z-plate-mute);
  }

  .serves code {
    background: none;
    color: inherit;
    font-size: 1em;
    padding: 0;
  }

  /* Every pane sits in the same cell, so the plate is as tall as the
     tallest one and doesn't change height as parts are picked. Only the
     picked pane is visible. */
  .panes {
    display: grid;
    flex: 1;
  }

  .pane {
    animation: swap 320ms ease both;
    display: flex;
    flex-direction: column;
    grid-area: 1 / 1;
  }

  .pane[hidden] {
    animation: none;
    display: flex;
    pointer-events: none;
    visibility: hidden;
  }

  @keyframes swap {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .code {
    flex: none;
  }

  .code :global(.astro-code) {
    background: var(--z-plate) !important;
    border: 0;
    border-radius: 0;
    counter-reset: ln;
    font-size: 0.8rem;
    line-height: 1.8;
    margin: 0;
    overflow-x: auto;
    padding: 1.1rem 0;
  }

  .code :global(.line) {
    counter-increment: ln;
    display: inline-block;
    min-width: 100%;
    padding: 0 1.3rem 0 0;
  }

  .code :global(.line)::before {
    color: #414955;
    content: counter(ln);
    display: inline-block;
    margin-right: 1.1rem;
    text-align: right;
    width: 2.4rem;
  }

  .code :global(.line.mark) {
    background: rgba(136, 192, 208, 0.09);
    box-shadow: inset 2px 0 0 #88c0d0;
  }

  .code :global(.line.mark)::before {
    color: #88c0d0;
  }

  .said {
    align-items: baseline;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin: 0;
    padding: 0.8rem 1.3rem;
  }

  .tag {
    color: #88c0d0;
    font: 500 0.7rem/1 var(--sl-font-mono);
  }

  .said code {
    background: none;
    color: #d8dee9;
    font: var(--z-code-weight, 500) 0.78rem/1.5 var(--sl-font-mono);
    padding: 0;
  }

  /* A shorter pane's spare height goes here, at the bottom. */
  .exchange {
    background: #0b0d10;
    border-top: 1px solid var(--rule);
    flex: 1;
    font: var(--z-code-weight, 500) 0.76rem/1.55 var(--sl-font-mono);
    padding: 0.85rem 1.3rem 1rem;
  }

  .exchange p {
    color: var(--z-plate-mute);
    display: flex;
    gap: 0.7rem;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .exchange .dir {
    flex: none;
    width: 0.8rem;
  }

  .exchange .in {
    color: #d8dee9;
  }

  .exchange .in .dir {
    color: #88c0d0;
  }

  .exchange .out {
    color: #a3be8c;
    font-weight: 500;
  }

  /* A refused request: the 400s and 422s here are Zinc doing its job. */
  .exchange .out.err {
    color: #ebcb8b;
  }

  @media (max-width: 60rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .pane {
      animation: none;
    }
  }
</style>
