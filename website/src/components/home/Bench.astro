---
// Figures from BENCHMARKS.md (Apple M1 Pro, go1.26.1, commit 5f77c75). ns/op, lower is better.
const frameworks = ["Zinc", "Gin", "Echo", "Chi"];
const workloads = [
  { id: "hello", name: "Hello world", bench: "HelloWorld", ns: [65.27, 89.27, 138.2, 198.9] },
  { id: "param", name: "Route param", bench: "RouterParam", ns: [80.65, 94.61, 132.4, 345.9] },
  { id: "chain", name: "Middleware chain", bench: "MiddlewareChain", ns: [365.1, 424.2, 540.5, 950.0] },
  { id: "api", name: "API request", bench: "APIHappyPath", ns: [1186, 3024, 2287, 1737] },
  { id: "parallel", name: "Parallel param", bench: "ParallelRouterParam", ns: [13.68, 53.86, 56.11, 315.4] },
  { id: "notfound", name: "Not found", bench: "NotFound", ns: [72.18, 58.46, 598.0, 349.5] },
];

const fmt = (n: number) => (n >= 1000 ? n.toLocaleString("en-US") : n.toFixed(n < 100 ? 2 : 1));
const rows = (ns: number[]) => {
  const max = Math.max(...ns);
  const min = Math.min(...ns);
  return frameworks.map((name, i) => ({
    name,
    ns: ns[i],
    label: fmt(ns[i]),
    width: (ns[i] / max) * 100,
    ratio: ns[i] === min ? "fastest" : `${(ns[i] / min).toFixed(2)}×`,
  }));
};
const first = workloads[0];
---

<section class="bench">
  <div class="summary">
    <p class="kicker">Measured, in the repo</p>
    <p class="hero-num"><strong>62</strong><span>/ 77</span></p>
    <p class="caption">
      Benchmarks where Zinc recorded the lowest latency against Gin, Echo, and Chi. Gin led 10 and Chi led 5.
    </p>
    <p class="env">Apple M1 Pro · go1.26.1 · commit 5f77c75</p>
    <a class="more" href="/extra/benchmarks/">Full benchmark report →</a>
  </div>

  <figure class="chart" data-bench data-workloads={JSON.stringify(workloads)}>
    <div class="controls" role="radiogroup" aria-label="Workload">
      {workloads.map((w, i) => (
        <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-workload={w.id}>{w.name}</button>
      ))}
    </div>

    <p class="chart-title">
      <span data-bench-name>{first.bench}</span>
      <span>ns/op · lower is faster</span>
    </p>

    <ol class="bars">
      {rows(first.ns).map((r) => (
        <li data-framework={r.name} data-fastest={r.ratio === "fastest" ? "true" : "false"}>
          <span class="name">{r.name}</span>
          <span class="track"><span class="bar" style={`width:${r.width}%`}></span></span>
          <span class="value"><b>{r.label}</b><i>{r.ratio}</i></span>
        </li>
      ))}
    </ol>
  </figure>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-bench]").forEach((root) => {
    const workloads: { id: string; bench: string; ns: number[] }[] = JSON.parse(root.dataset.workloads || "[]");
    const fmt = (n: number) => (n >= 1000 ? n.toLocaleString("en-US") : n.toFixed(n < 100 ? 2 : 1));
    const items = [...root.querySelectorAll<HTMLElement>(".bars li")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-workload]")];

    const show = (id: string) => {
      const w = workloads.find((x) => x.id === id);
      if (!w) return;
      const max = Math.max(...w.ns);
      const min = Math.min(...w.ns);
      root.querySelector("[data-bench-name]")!.textContent = w.bench;
      items.forEach((li, i) => {
        li.querySelector<HTMLElement>(".bar")!.style.width = `${(w.ns[i] / max) * 100}%`;
        li.querySelector("b")!.textContent = fmt(w.ns[i]);
        li.querySelector("i")!.textContent = w.ns[i] === min ? "fastest" : `${(w.ns[i] / min).toFixed(2)}×`;
        li.dataset.fastest = String(w.ns[i] === min);
      });
      buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.workload === id)));
    };

    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.workload!)));
  });
</script>

<style>
  .bench {
    align-items: center;
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1.25rem;
  }

  .hero-num {
    align-items: baseline;
    color: var(--z-text);
    display: flex;
    font-family: var(--sl-font-mono);
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .hero-num strong {
    font-size: clamp(4.5rem, 9vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .hero-num span {
    color: var(--z-soft);
    font-size: 1.4rem;
  }

  .caption {
    color: var(--z-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 34ch;
  }

  .env {
    color: var(--z-soft);
    font: 400 0.7rem/1.4 var(--sl-font-mono);
    margin: 0 0 1.5rem;
  }

  .more {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    color: var(--z-zn);
  }

  .chart {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    margin: 0;
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.6rem;
  }

  .controls button {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--z-muted);
    cursor: pointer;
    font: 500 0.78rem/1 var(--sl-font);
    padding: 0.5rem 0.8rem;
    transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .controls button:hover {
    border-color: var(--sl-color-hairline-light);
    color: var(--z-text);
  }

  .controls button[aria-checked="true"] {
    background: var(--z-text);
    border-color: var(--z-text);
    color: var(--sl-color-bg);
  }

  .chart-title {
    color: var(--z-muted);
    display: flex;
    flex-wrap: wrap;
    font: 400 0.72rem/1 var(--sl-font-mono);
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin: 0 0 1rem;
  }

  .chart-title span:first-child {
    color: var(--z-text);
  }

  .bars {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bars li {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: 3.2rem minmax(0, 1fr) 7.5rem;
    margin: 0;
  }

  .name {
    color: var(--z-body);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .track {
    background: repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), var(--sl-color-hairline) calc(25% - 1px) 25%);
    border-left: 1px solid var(--sl-color-hairline-light);
    display: block;
    height: 1.35rem;
  }

  .bar {
    background: var(--sl-color-gray-5);
    border-radius: 0 4px 4px 0;
    display: block;
    height: 100%;
    min-width: 2px;
    transition: width 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  li[data-framework="Zinc"] .name {
    color: var(--z-text);
    font-weight: 600;
  }

  li[data-framework="Zinc"] .bar {
    background: var(--z-zn);
  }

  .value {
    align-items: baseline;
    display: flex;
    font-family: var(--sl-font-mono);
    font-variant-numeric: tabular-nums;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .value b {
    color: var(--z-text);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .value i {
    color: var(--z-soft);
    font-size: 0.7rem;
    font-style: normal;
    min-width: 3.4rem;
    text-align: right;
  }

  li[data-fastest="true"] .value i {
    color: var(--z-text);
  }

  @media (max-width: 60rem) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .bars li {
      grid-template-columns: 2.8rem minmax(0, 1fr) 4.2rem;
      gap: 0.6rem;
    }

    .value i {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }
</style>
