---
// Reads the published results from the repository's BENCHMARKS.md at build
// time, so the homepage follows the report. ns/op, lower is better.
import fs from "node:fs";
import path from "node:path";

const frameworks = ["Zinc", "Gin", "Echo", "Chi"];
const source = [path.resolve(process.cwd(), "../BENCHMARKS.md"), path.resolve(process.cwd(), "BENCHMARKS.md")].find((p) => fs.existsSync(p));
const md = source ? fs.readFileSync(source, "utf8") : "";

const results = [...md.matchAll(/^\| `([^`]+)` \| ([\d.,]+) \| ([\d.,]+) \| ([\d.,]+) \| ([\d.,]+) \| (\w+) \|$/gm)].map((m) => ({
  bench: m[1],
  ns: [m[2], m[3], m[4], m[5]].map((v) => parseFloat(v.replace(/,/g, ""))),
  winner: m[6],
}));
const field = (label: string) => md.match(new RegExp(`${label}: \`([^\`]+)\``))?.[1] ?? "";
const run = { commit: field("Zinc commit"), go: field("Go"), machine: field("Machine"), date: field("Date") };
const historical = /Historical results/i.test(md);
const wins = Object.fromEntries(frameworks.map((f) => [f, results.filter((r) => r.winner === f).length]));
const runDate = run.date ? new Date(run.date + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }) : "";

const picks = [
  ["hello", "Hello world", "HelloWorld"],
  ["param", "Route param", "RouterParam"],
  ["chain", "Middleware chain", "MiddlewareChain"],
  ["api", "API request", "APIHappyPath"],
  ["parallel", "Parallel param", "ParallelRouterParam"],
  ["notfound", "Not found", "NotFound"],
];
const workloads = picks
  .map(([id, name, bench]) => ({ id, name, bench, ns: results.find((r) => r.bench === bench)?.ns }))
  .filter((w): w is { id: string; name: string; bench: string; ns: number[] } => !!w.ns);

const fmt = (n: number) => (n >= 1000 ? n.toLocaleString("en-US") : n.toFixed(n < 100 ? 2 : 1));
const rows = (ns: number[]) => {
  const max = Math.max(...ns);
  const min = Math.min(...ns);
  return frameworks.map((name, i) => ({
    name,
    ns: ns[i],
    label: fmt(ns[i]),
    width: (ns[i] / max) * 100,
    ratio: ns[i] === min ? "fastest" : `${(ns[i] / min).toFixed(2)}×`,
  }));
};
const first = workloads[0];
---

<section class="bench">
  <div class="summary">
    <p class="kicker">Measured, in the repo</p>
    <p class="hero-num"><strong>{wins.Zinc}</strong><span>/ {results.length}</span></p>
    <p class="caption">
      Scenarios where Zinc recorded the lowest latency against Gin, Echo, and Chi.
      Gin led {wins.Gin}, Chi {wins.Chi}, and Echo {wins.Echo}.
    </p>
    <ol class="winmap" aria-label={`${wins.Zinc} of ${results.length} scenarios won by Zinc`}>
      {results.map((r) => (
        <li data-zinc={r.winner === "Zinc" ? "" : undefined} title={`${r.bench}: ${r.winner} fastest · Zinc ${fmt(r.ns[0])} ns`}></li>
      ))}
    </ol>
    <p class="legend"><span><i class="z"></i>Zinc fastest</span><span><i></i>A rival fastest</span></p>
    <p class="env">
      <span class="when">{historical && <span class="hist">Historical run</span>}{runDate}</span>
      <span>{run.machine} · {run.go} · commit {run.commit}</span>
    </p>
    <a class="more" href="/extra/benchmarks/">Full benchmark report →</a>
  </div>

  <figure class="chart" data-bench data-workloads={JSON.stringify(workloads)}>
    <div class="controls" role="radiogroup" aria-label="Workload">
      {workloads.map((w, i) => (
        <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-workload={w.id}>{w.name}</button>
      ))}
    </div>

    <p class="chart-title">
      <span data-bench-name>{first.bench}</span>
      <span>ns/op · lower is faster</span>
    </p>

    <ol class="bars">
      {rows(first.ns).map((r) => (
        <li data-framework={r.name} data-fastest={r.ratio === "fastest" ? "true" : "false"}>
          <span class="name">{r.name}</span>
          <span class="track"><span class="bar" style={`width:${r.width}%`}></span></span>
          <span class="value"><b>{r.label}</b><i>{r.ratio}</i></span>
        </li>
      ))}
    </ol>
  </figure>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-bench]").forEach((root) => {
    const workloads: { id: string; bench: string; ns: number[] }[] = JSON.parse(root.dataset.workloads || "[]");
    const fmt = (n: number) => (n >= 1000 ? n.toLocaleString("en-US") : n.toFixed(n < 100 ? 2 : 1));
    const items = [...root.querySelectorAll<HTMLElement>(".bars li")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-workload]")];

    const show = (id: string) => {
      const w = workloads.find((x) => x.id === id);
      if (!w) return;
      const max = Math.max(...w.ns);
      const min = Math.min(...w.ns);
      root.querySelector("[data-bench-name]")!.textContent = w.bench;
      items.forEach((li, i) => {
        li.querySelector<HTMLElement>(".bar")!.style.width = `${(w.ns[i] / max) * 100}%`;
        li.querySelector("b")!.textContent = fmt(w.ns[i]);
        li.querySelector("i")!.textContent = w.ns[i] === min ? "fastest" : `${(w.ns[i] / min).toFixed(2)}×`;
        li.dataset.fastest = String(w.ns[i] === min);
      });
      buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.workload === id)));
    };

    buttons.forEach((b) => b.addEventListener("click", () => show(b.dataset.workload!)));

    // Bars grow from zero the first time the chart scrolls into view.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      root.classList.add("await");
      const seen = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        root.classList.add("shown");
        seen.disconnect();
      }, { threshold: 0.35 });
      seen.observe(root);
    }
  });
</script>

<style>
  .bench {
    align-items: center;
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1.25rem;
  }

  .hero-num {
    align-items: baseline;
    color: var(--z-text);
    display: flex;
    font-family: var(--sl-font-mono);
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .hero-num strong {
    font-size: clamp(4.5rem, 9vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .hero-num span {
    color: var(--z-soft);
    font-size: 1.4rem;
  }

  .caption {
    color: var(--z-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1rem;
    max-width: 34ch;
  }

  /* One square per scenario: filled where Zinc was fastest. */
  .winmap {
    display: grid;
    gap: 3px;
    grid-template-columns: repeat(auto-fill, minmax(9px, 1fr));
    list-style: none;
    margin: 0 0 0.6rem;
    max-width: 22rem;
    padding: 0;
  }

  .winmap li {
    aspect-ratio: 1;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--sl-color-hairline-light);
    margin: 0;
  }

  .winmap li[data-zinc] {
    background: var(--z-zn);
    box-shadow: none;
  }

  .legend {
    color: var(--z-soft);
    display: flex;
    flex-wrap: wrap;
    font: 400 0.7rem/1 var(--sl-font-mono);
    gap: 0.4rem 1rem;
    margin: 0 0 1.25rem;
  }

  .legend span {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }

  .legend i {
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--sl-color-hairline-light);
    height: 9px;
    width: 9px;
  }

  .legend i.z {
    background: var(--z-zn);
    box-shadow: none;
  }

  .env {
    color: var(--z-soft);
    display: grid;
    font: 400 0.7rem/1.6 var(--sl-font-mono);
    gap: 0.45rem;
    margin: 0 0 1.5rem;
  }

  .when {
    align-items: center;
    display: flex;
  }

  .hist {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 4px;
    color: var(--z-muted);
    margin-right: 0.5rem;
    padding: 0.1rem 0.4rem;
  }

  .more {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    color: var(--z-zn);
  }

  .chart {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    margin: 0;
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.6rem;
  }

  .controls button {
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--z-muted);
    cursor: pointer;
    font: 500 0.78rem/1 var(--sl-font);
    padding: 0.5rem 0.8rem;
    transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
  }

  .controls button:hover {
    border-color: var(--sl-color-hairline-light);
    color: var(--z-text);
  }

  .controls button[aria-checked="true"] {
    background: var(--z-text);
    border-color: var(--z-text);
    color: var(--sl-color-bg);
  }

  .chart-title {
    color: var(--z-muted);
    display: flex;
    flex-wrap: wrap;
    font: 400 0.72rem/1 var(--sl-font-mono);
    gap: 0.5rem 1rem;
    justify-content: space-between;
    margin: 0 0 1rem;
  }

  .chart-title span:first-child {
    color: var(--z-text);
  }

  .bars {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bars li {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: 3.2rem minmax(0, 1fr) 7.5rem;
    margin: 0;
  }

  .name {
    color: var(--z-body);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .track {
    background: repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), var(--sl-color-hairline) calc(25% - 1px) 25%);
    border-left: 1px solid var(--sl-color-hairline-light);
    display: block;
    height: 1.35rem;
  }

  :global(.await):not(:global(.shown)) .bar {
    width: 0 !important;
  }

  .bar {
    background: var(--sl-color-gray-5);
    border-radius: 0 4px 4px 0;
    display: block;
    height: 100%;
    min-width: 2px;
    transition: width 420ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  li[data-framework="Zinc"] .name {
    color: var(--z-text);
    font-weight: 600;
  }

  li[data-framework="Zinc"] .bar {
    background: var(--z-zn);
  }

  .value {
    align-items: baseline;
    display: flex;
    font-family: var(--sl-font-mono);
    font-variant-numeric: tabular-nums;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .value b {
    color: var(--z-text);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .value i {
    color: var(--z-soft);
    font-size: 0.7rem;
    font-style: normal;
    min-width: 3.4rem;
    text-align: right;
  }

  li[data-fastest="true"] .value i {
    color: var(--z-text);
  }

  @media (max-width: 60rem) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 30rem) {
    .bars li {
      grid-template-columns: 2.8rem minmax(0, 1fr) 4.2rem;
      gap: 0.6rem;
    }

    .value i {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }
</style>
