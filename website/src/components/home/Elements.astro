---
// The 29 first-party middleware, laid out as a periodic table and grouped by job.
// Each family is cast in a real metal chosen for what it does.
type Group = "protect" | "observe" | "control" | "transport";

const groups: { id: Group; name: string; metal: string; symbol: string }[] = [
  { id: "protect", name: "Protect", metal: "iron", symbol: "Fe" }, // armour
  { id: "observe", name: "Observe", metal: "copper", symbol: "Cu" }, // carries the signals
  { id: "control", name: "Control", metal: "titanium", symbol: "Ti" }, // holds under load
  { id: "transport", name: "Transport", metal: "aluminium", symbol: "Al" }, // light and fast
];

const elements: [string, string, string, Group, string][] = [
  ["Ba", "Basic Auth", "BasicAuth", "protect", "basic-auth"],
  ["Cb", "Casbin", "CasbinAuth", "protect", "casbin-auth"],
  ["Co", "CORS", "CORS", "protect", "cors"],
  ["Cf", "CSRF", "CSRF", "protect", "csrf"],
  ["Hg", "Header Guards", "AllowContentType", "protect", "header-guards"],
  ["Jw", "JWT", "JWT", "protect", "jwt"],
  ["Ka", "Key Auth", "KeyAuth", "protect", "key-auth"],
  ["Sh", "Secure Headers", "Secure", "protect", "secure"],
  ["Ss", "Session", "SessionCookie", "protect", "session"],
  ["Bd", "Body Dump", "BodyDump", "observe", "body-dump"],
  ["Jg", "Jaeger", "Jaeger", "observe", "jaeger"],
  ["Ot", "OpenTelemetry", "otelhttp", "observe", "open-telemetry"],
  ["Pp", "pprof", "Pprof", "observe", "pprof"],
  ["Pm", "Prometheus", "Prometheus", "observe", "prometheus"],
  ["Ri", "Request ID", "RequestID", "observe", "request-id"],
  ["Lg", "Request Logger", "RequestLogger", "observe", "request-logger"],
  ["Bl", "Body Limit", "BodyLimit", "control", "body-limit"],
  ["Ct", "Context Timeout", "ContextTimeout", "control", "context-timeout"],
  ["Rl", "Rate Limiter", "RateLimiter", "control", "rate-limiter"],
  ["Rc", "Recover", "Recover", "control", "recover"],
  ["Ut", "Utility", "NoCache", "control", "utility"],
  ["Dz", "Decompress", "Decompress", "transport", "decompress"],
  ["Gz", "Gzip", "Gzip", "transport", "gzip"],
  ["Mo", "Method Override", "MethodOverride", "transport", "method-override"],
  ["Px", "Proxy", "Proxy", "transport", "proxy"],
  ["Rd", "Redirect", "Redirect", "transport", "redirect"],
  ["Rw", "Rewrite", "Rewrite", "transport", "rewrite"],
  ["St", "Static", "Static", "transport", "static"],
  ["Ts", "Trailing Slash", "TrailingSlash", "transport", "trailing-slash"],
];

const count = (g: Group) => elements.filter((e) => e[3] === g).length;
const metal = Object.fromEntries(groups.map((g) => [g.id, g])) as Record<Group, (typeof groups)[number]>;
---

<section class="elements" data-elements>
  <div class="head">
    <div>
      <p class="kicker">Middleware</p>
      <h2>A periodic table of production parts.</h2>
      <p class="cast">
        Each family is cast in its own metal: {groups.map((g, i) => (
          <>{i > 0 && (i === groups.length - 1 ? ", and " : ", ")}{g.name} in <span class="metal" data-group={g.id}>{g.metal}</span></>
        ))}. Hover any part to galvanize it.
      </p>
    </div>
    <div class="filters" role="radiogroup" aria-label="Filter middleware">
      <button type="button" role="radio" aria-checked="true" data-filter="all">All <span>{elements.length}</span></button>
      {groups.map((g) => (
        <button type="button" role="radio" aria-checked="false" data-filter={g.id} data-group={g.id}>
          <i class="swatch" aria-hidden="true"></i>{g.name} <span>{count(g.id)}</span>
        </button>
      ))}
    </div>
  </div>

  <ol class="table">
    {elements.map(([sym, name, fn, group, slug], i) => (
      <li data-group={group} data-first={i === 0 || elements[i - 1][3] !== group ? "" : undefined}>
        <a href={`/middleware/${slug}/`}>
          <span class="top"><span class="num">{i + 1}</span><span class="grp" title={`${metal[group].name}: ${metal[group].metal}`}>{metal[group].symbol}</span></span>
          <span class="sym">{sym}</span>
          <span class="name">{name}</span>
          <span class="fn">{fn}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-elements]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        const f = b.dataset.filter!;
        buttons.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
        root.dataset.active = f === "all" ? "" : f;
      }),
    );
  });
</script>

<style>
  /* Each family has a photographed metal surface. The image stays decorative;
     contrast comes from the per-metal wash and text colors. */
  [data-group="protect"] {
    --plate-image: url("/middleware-metals/protect-iron.webp");
    --plate-wash: rgba(8, 14, 22, 0.07);
    --plate-ink: #f8fafc;
    --plate-muted-ink: #dce4ec;
    --plate-edge: #38434e;
  }
  [data-group="observe"] {
    --plate-image: url("/middleware-metals/observe-copper.webp");
    --plate-wash: rgba(28, 12, 4, 0.08);
    --plate-ink: #fff9f2;
    --plate-muted-ink: #f4dec9;
    --plate-edge: #7d4e30;
  }
  [data-group="control"] {
    --plate-image: url("/middleware-metals/control-titanium.webp");
    --plate-wash: rgba(255, 255, 255, 0.24);
    --plate-ink: #17202d;
    --plate-muted-ink: #334052;
    --plate-edge: #a6aab7;
  }
  [data-group="transport"] {
    --plate-image: url("/middleware-metals/transport-aluminium.webp");
    --plate-wash: rgba(255, 255, 255, 0.06);
    --plate-ink: #202a34;
    --plate-muted-ink: #374451;
    --plate-edge: #bbc2c9;
  }

  .head {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    justify-content: space-between;
    margin-bottom: 1.75rem;
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  h2 {
    color: var(--z-text);
    font: 600 clamp(1.9rem, 3.4vw, 2.6rem) / 1.08 var(--sl-font);
    letter-spacing: -0.035em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }

  .cast {
    color: var(--z-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.9rem 0 0;
    max-width: 52ch;
  }

  .metal {
    background: linear-gradient(var(--plate-wash), var(--plate-wash)), var(--plate-image) center / cover;
    border: 1px solid var(--plate-edge);
    border-radius: 4px;
    color: var(--plate-ink);
    font: 500 0.82em/1 var(--sl-font-mono);
    padding: 0.12em 0.4em;
    white-space: nowrap;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .filters button {
    align-items: center;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    color: var(--z-muted);
    cursor: pointer;
    display: inline-flex;
    font: 500 0.8rem/1 var(--sl-font);
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .swatch {
    background: linear-gradient(var(--plate-wash), var(--plate-wash)), var(--plate-image) center / cover;
    border: 1px solid var(--plate-edge);
    border-radius: 3px;
    height: 0.85rem;
    width: 0.85rem;
  }

  .filters button span {
    color: var(--z-soft);
    font: 400 0.72rem/1 var(--sl-font-mono);
  }

  .filters button:hover,
  .filters button[aria-checked="true"] {
    border-color: var(--z-muted);
    color: var(--z-text);
  }

  .table {
    display: grid;
    gap: 6px;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .table li[data-first] {
    grid-column-start: 1;
  }

  .table li {
    margin: 0;
    transition: opacity 200ms ease;
  }

  .table a {
    aspect-ratio: 1 / 0.92;
    background: linear-gradient(var(--plate-wash), var(--plate-wash)), var(--plate-image) center / cover;
    border: 1px solid var(--plate-edge);
    border-radius: 6px;
    color: var(--plate-ink);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    max-width: 100%;
    padding: 0.55rem 0.65rem 0.6rem;
    position: relative;
    text-decoration: none;
    transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
  }

  /* Hover galvanizes the plate: the same spangle as the Zinc tile. */
  .table a::after {
    background: #c9ced3 url("/zn-spangle-hd.webp") center / 180px auto;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    content: "";
    inset: -1px;
    opacity: 0;
    position: absolute;
    transition: opacity 200ms ease;
    z-index: 0;
  }

  .table a > * {
    position: relative;
    z-index: 1;
    transition: color 200ms ease;
  }

  .table a:hover,
  .table a:focus-visible {
    border-color: transparent;
    box-shadow: 0 10px 22px -14px rgba(0, 0, 0, 0.6);
    transform: translateY(-2px);
  }

  .table a:hover::after,
  .table a:focus-visible::after {
    opacity: 1;
  }

  .table a:hover > *,
  .table a:focus-visible > * {
    color: #1a1d21;
  }

  .top {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .num,
  .grp {
    color: var(--plate-muted-ink);
    font: 500 0.64rem/1 var(--sl-font-mono);
  }

  .grp {
    color: var(--plate-ink);
    font-weight: 600;
    opacity: 0.8;
  }

  .table a:hover .num,
  .table a:hover .grp,
  .table a:hover .fn {
    color: #3a4047;
  }

  .sym {
    align-self: center;
    color: var(--plate-ink);
    font: 400 clamp(1.1rem, 1.9vw, 1.55rem)/1 var(--z-font-display);
    letter-spacing: -0.02em;
  }

  .name {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fn {
    color: var(--plate-muted-ink);
    font: 400 0.62rem/1.4 var(--sl-font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  [data-active="protect"] li:not([data-group="protect"]),
  [data-active="observe"] li:not([data-group="observe"]),
  [data-active="control"] li:not([data-group="control"]),
  [data-active="transport"] li:not([data-group="transport"]) {
    opacity: 0.16;
  }

  @media (max-width: 72rem) {
    .table {
      grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    }

    .table li[data-first] {
      grid-column-start: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .table a,
    .table a::after {
      transition: none;
    }

    .table a:hover {
      transform: none;
    }
  }
</style>
