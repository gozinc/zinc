---
import fs from "node:fs";
import path from "node:path";

// The release shown in the hero comes from version.go, so it cannot drift.
const versionFile = path.resolve(process.cwd(), "../version.go");
const version = fs.readFileSync(versionFile, "utf8").match(/const Version = "([^"]+)"/)?.[1];
if (!version) throw new Error(`No Version constant in ${versionFile}`);

// A small, real Zinc handler. The responses below are what Zinc sends for it,
// captured by running this code; keep them in step if the code changes.
const source = `app := zinc.New()

app.Get("/users/{id}", func(c *zinc.Context) error {
	user, ok := users[c.Param("id")]
	if !ok {
		return zinc.NotFound("user not found")
	}
	return c.JSON(user)
})

app.Listen(":8080")`;

// Each request names the source line that answers it (0-based).
const exchanges = [
  { path: "/users/42", status: "200 OK", line: 7, body: `{"id":"42","name":"Ada Lovelace"}` },
  { path: "/users/7", status: "404 Not Found", line: 5, body: `{"error":{"status":404,"message":"user not found"}}` },
];

// A small Go highlighter, run at build time.
const keywords = new Set(["func", "return", "if", "err", "nil", "ok", "error"]);
const tokenize = (line: string): [string, string][] => {
  const out: [string, string][] = [];
  const re = /(\/\/.*$)|("(?:[^"\\]|\\.)*")|(\b\d+\b)|([A-Za-z_][A-Za-z0-9_]*)(?=\s*[\[(])|([A-Za-z_][A-Za-z0-9_]*)|(\s+)|(.)/g;
  for (const m of line.matchAll(re)) {
    const [text, comment, str, num, call, word, space] = m;
    if (comment) out.push([text, "cm"]);
    else if (str) out.push([text, "str"]);
    else if (num) out.push([text, "num"]);
    else if (call) out.push([text, keywords.has(call) ? "kw" : "fn"]);
    else if (word) out.push([text, keywords.has(word) ? "kw" : word === "zinc" || word === "Context" || word === "int" ? "ty" : "id"]);
    else if (space) out.push([text, "sp"]);
    else out.push([text, "pn"]);
  }
  return out;
};
const lines = source.split("\n").map(tokenize);
---

<section class="lead">
  <div class="intro">
    <p class="meta">
      <span class="tile" aria-hidden="true"><b>30</b>Zn</span>
      <span>v{version}</span><i></i><span>MIT</span><i></i><span>Go 1.25+</span>
    </p>
    <h1>Galvanize <code>net/http</code>.</h1>
    <p class="lede">
      The high-performance, minimalist web layer for Go. Routing, binding, errors, and 27 middleware packages,
      applied as a thin coat over the standard library you already trust.
    </p>
    <div class="actions">
      <a class="btn primary" href="/guide/quickstart/">Get started</a>
      <a class="btn" href="https://github.com/0mjs/zinc">GitHub</a>
    </div>
    <button class="install" type="button" data-copy="go get github.com/0mjs/zinc">
      <span class="prompt">$</span>
      <code>go get github.com/0mjs/zinc</code>
      <span class="copy" data-copy-label>Copy</span>
    </button>
  </div>

  <div class="demo" data-demo data-exchanges={JSON.stringify(exchanges)}>
    <div class="d-head">
      <span class="d-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="d-file">main.go</span>
    </div>

    <pre class="d-code" aria-label="A Zinc handler"><code>{lines.map((line, i) => (
      <span class="line" data-line={i}>{line.length ? line.map(([t, c]) => <span class={`t-${c}`}>{t}</span>) : " "}</span>
    ))}</code></pre>

    <div class="d-term">
      <div class="d-bar" aria-hidden="true">
        <span>Terminal</span>
        <span class="d-steps">{exchanges.map((_, i) => <i data-step={i} data-on={i === 0 ? "" : undefined}></i>)}</span>
      </div>
      <!-- Every exchange is laid out invisibly in the same cell, so the
           terminal is always as tall as the longest response. -->
      <div class="d-screen">
        {exchanges.map((x) => (
          <div class="d-run ghost" aria-hidden="true">
            <p class="cmd"><span class="prompt">$</span> curl -i localhost:8080{x.path}</p>
            <p class="status">HTTP/1.1 {x.status}</p>
            <p class="hdr">Content-Type: application/json; charset=utf-8</p>
            <p class="body">{x.body}</p>
          </div>
        ))}
        <div class="d-run live" aria-live="polite" data-run data-code={exchanges[0].status.slice(0, 3)}>
          <p class="cmd"><span class="prompt">$</span> <span data-typed>curl -i localhost:8080{exchanges[0].path}</span><span class="caret" aria-hidden="true"></span></p>
          <p class="status" data-out>HTTP/1.1 {exchanges[0].status}</p>
          <p class="hdr" data-out>Content-Type: application/json; charset=utf-8</p>
          <p class="body" data-out>{exchanges[0].body}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".lead .install").forEach((button) => {
    button.addEventListener("click", async () => {
      const label = button.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(button.dataset.copy || "");
        if (label) label.textContent = "Copied";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(button.querySelector("code")!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        if (label) label.textContent = "Selected";
      }
      setTimeout(() => label && (label.textContent = "Copy"), 1400);
    });
  });

  type Exchange = { path: string; status: string; line: number; body: string };

  const TYPE = 32; // ms per typed character
  const LATENCY = 380; // the pause while the request is in flight
  const REVEAL = 110; // ms between response lines
  const HOLD = 3400; // how long a finished response stays up

  document.querySelectorAll<HTMLElement>("[data-demo]").forEach((root) => {
    const exchanges: Exchange[] = JSON.parse(root.dataset.exchanges || "[]");
    const run = root.querySelector<HTMLElement>("[data-run]")!;
    const typed = run.querySelector<HTMLElement>("[data-typed]")!;
    const outputs = [...run.querySelectorAll<HTMLElement>("[data-out]")];
    const codeLines = [...root.querySelectorAll<HTMLElement>("[data-line]")];
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const mark = (line: number | null) => codeLines.forEach((el, i) => el.toggleAttribute("data-hit", i === line));
    mark(exchanges[0]?.line ?? null);
    if (reduced || exchanges.length === 0) return;

    let index = 0;
    let timer = 0;
    let visible = true;
    const wait = (ms: number) => new Promise<void>((done) => (timer = window.setTimeout(done, ms)));

    const play = async (x: Exchange, i: number) => {
      steps.forEach((s, n) => s.toggleAttribute("data-on", n === i));
      run.dataset.code = x.status.slice(0, 3);
      run.removeAttribute("data-done");
      outputs.forEach((o) => o.removeAttribute("data-shown"));
      mark(null);
      const command = `curl -i localhost:8080${x.path}`;
      typed.textContent = "";
      for (const ch of command) {
        typed.textContent += ch;
        await wait(TYPE);
      }
      await wait(LATENCY);
      outputs[0].textContent = `HTTP/1.1 ${x.status}`;
      outputs[2].textContent = x.body;
      mark(x.line);
      for (const o of outputs) {
        o.setAttribute("data-shown", "");
        await wait(REVEAL);
      }
      run.setAttribute("data-done", "");
    };

    const loop = async () => {
      while (true) {
        if (!visible) {
          await wait(400);
          continue;
        }
        await play(exchanges[index], index);
        await wait(HOLD);
        index = (index + 1) % exchanges.length;
      }
    };

    // Only animate while the hero is on screen.
    new IntersectionObserver((entries) => (visible = entries[0].isIntersecting)).observe(root);
    run.setAttribute("data-animated", "");
    loop();
  });
</script>

<style>
  .lead {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 4.5rem) 1rem;
  }

  .meta {
    align-items: center;
    color: var(--z-muted);
    display: flex;
    flex-wrap: wrap;
    font: 500 0.72rem/1 var(--sl-font-mono);
    gap: 0.7rem;
    letter-spacing: 0.04em;
    margin: 0 0 1.6rem;
  }

  .meta i {
    background: var(--sl-color-hairline-light);
    height: 0.9rem;
    width: 1px;
  }

  .tile {
    background: #c9ced3 url("/zn-spangle-hd.webp") center / cover;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35), 0 0 0 1px var(--sl-color-hairline-light);
    color: #1e2226;
    display: grid;
    font: 400 0.95rem/1 var(--z-font-display);
    height: 2.6rem;
    margin-right: 0.35rem;
    place-items: end center;
    padding-bottom: 0.45rem;
    position: relative;
    width: 2.6rem;
  }

  .tile b {
    font: 500 0.5rem/1 var(--sl-font-mono);
    left: 0.3rem;
    position: absolute;
    top: 0.25rem;
  }

  /* One colour, a calmer size. net/http is set as code because it is code. */
  h1 {
    color: var(--z-text);
    font: 600 clamp(2.3rem, 4.2vw, 3.25rem) / 1.05 var(--sl-font);
    letter-spacing: -0.042em;
    margin: 0;
    text-wrap: balance;
  }

  h1 code {
    background: none;
    border: 0;
    color: inherit;
    font: 500 0.9em / 1 var(--sl-font-mono);
    letter-spacing: -0.045em;
    padding: 0;
  }

  .lede {
    color: var(--z-muted);
    font-size: 1.08rem;
    line-height: 1.6;
    margin: 1.25rem 0 1.9rem;
    max-width: 46ch;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    align-items: center;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--z-radius);
    color: var(--z-text);
    display: inline-flex;
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease;
  }

  .btn:hover {
    background: var(--z-zn-soft);
    border-color: var(--z-muted);
  }

  .btn.primary {
    background: var(--z-text);
    border-color: var(--z-text);
    color: var(--sl-color-bg);
  }

  .btn.primary:hover {
    background: var(--z-zn);
    border-color: var(--z-zn);
  }

  .install {
    align-items: center;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--z-body);
    cursor: pointer;
    display: flex;
    font: 400 0.82rem/1 var(--sl-font-mono);
    gap: 0.7rem;
    margin-top: 2rem;
    max-width: 30rem;
    padding: 1.1rem 0 0;
    text-align: left;
    width: 100%;
  }

  .install code {
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 0;
  }

  .install .prompt,
  .install .copy {
    color: var(--z-soft);
  }

  .install .copy {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin-left: auto;
    text-transform: uppercase;
  }

  .install:hover .copy {
    color: var(--z-text);
  }

  /* The demo: an editor and a terminal, on the dark plate the code blocks use. */
  .demo {
    --rule: #1f242a; /* the plate is dark in both themes, so its rules are fixed too */
    background: var(--z-plate);
    border: 1px solid var(--rule);
    border-radius: 10px;
    color: var(--z-plate-ink);
    font-family: var(--sl-font-mono);
    min-width: 0;
    overflow: hidden;
  }

  .d-head {
    align-items: center;
    background: var(--z-plate-bar);
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 0.9rem;
    padding: 0.65rem 1rem;
  }

  .d-dots {
    display: flex;
    gap: 0.35rem;
  }

  .d-dots i {
    background: #2a3038;
    border-radius: 50%;
    height: 0.55rem;
    width: 0.55rem;
  }

  .d-file {
    color: var(--z-plate-mute);
    font-size: 0.72rem;
  }

  .d-code {
    background: transparent;
    border: 0;
    border-radius: 0;
    counter-reset: line;
    font: var(--z-code-weight) 0.78rem/1.7 var(--sl-font-mono);
    margin: 0;
    overflow-x: auto;
    padding: 0.85rem 0;
  }

  .d-code code {
    display: grid;
  }

  .d-code .line {
    border-left: 2px solid transparent;
    padding: 0 1rem 0 0.8rem;
    tab-size: 2;
    transition: background-color 220ms ease, border-color 220ms ease;
    white-space: pre;
  }

  .d-code .line::before {
    color: #3b434d;
    content: counter(line);
    counter-increment: line;
    display: inline-block;
    margin-right: 1rem;
    text-align: right;
    width: 1.2rem;
  }

  /* The line that answered the current request. */
  .d-code .line[data-hit] {
    background: rgba(136, 192, 208, 0.08);
    border-left-color: var(--z-code-fn);
  }

  .d-code :global(.t-id) { color: #d8dee9; }
  .d-code :global(.t-kw) { color: var(--z-code-kw); }
  .d-code :global(.t-fn) { color: var(--z-code-fn); }
  .d-code :global(.t-ty) { color: var(--z-code-type); }
  .d-code :global(.t-str) { color: var(--z-code-str); }
  .d-code :global(.t-num) { color: var(--z-code-num); }
  .d-code :global(.t-pn) { color: #7d889a; }
  .d-code :global(.t-cm) { color: #6c788e; }

  .d-term {
    background: #0a0c0f;
    border-top: 1px solid var(--rule);
  }

  .d-bar {
    align-items: center;
    color: var(--z-plate-mute);
    display: flex;
    font-size: 0.68rem;
    justify-content: space-between;
    padding: 0.55rem 1rem 0;
  }

  .d-steps {
    display: flex;
    gap: 0.3rem;
  }

  .d-steps i {
    background: #2a3038;
    border-radius: 999px;
    height: 0.25rem;
    transition: background-color 200ms ease, width 200ms ease;
    width: 0.5rem;
  }

  .d-steps i[data-on] {
    background: var(--z-code-fn);
    width: 1rem;
  }

  .d-screen {
    display: grid;
    padding: 0.6rem 1rem 0.95rem;
  }

  .d-run {
    font-size: 0.76rem;
    grid-area: 1 / 1;
    line-height: 1.6;
    min-width: 0;
  }

  .d-run p {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .ghost {
    visibility: hidden;
  }

  .cmd {
    color: #eceff4;
  }

  .prompt {
    color: var(--z-plate-mute);
  }

  .status {
    font-weight: 600;
    margin-top: 0.5rem !important;
  }

  .d-run[data-code^="2"] .status {
    color: var(--z-code-str);
  }

  .d-run[data-code^="4"] .status {
    color: #d08770;
  }

  .hdr {
    color: var(--z-plate-mute);
  }

  .body {
    color: #d8dee9;
    margin-top: 0.35rem !important;
  }

  .caret {
    background: var(--z-code-fn);
    display: inline-block;
    height: 0.95em;
    margin-left: 2px;
    vertical-align: -0.12em;
    width: 0.45em;
  }

  /* While animating: the caret blinks until the request completes, and the
     response lines rise in one after another. */
  .d-run[data-animated] [data-out] {
    opacity: 0;
    transform: translateY(4px);
  }

  /* A new request clears the old response at once; only the reveal fades. */
  .d-run[data-animated] [data-out][data-shown] {
    opacity: 1;
    transform: none;
    transition: opacity 260ms ease, transform 260ms ease;
  }

  .d-run[data-animated] .caret {
    animation: blink 1s steps(1) infinite;
  }

  .d-run[data-animated][data-done] .caret {
    visibility: hidden;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 60rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* On phones, shrink the demo so the longest line and header fit. */
  @media (max-width: 30rem) {
    .d-code {
      font-size: 0.64rem;
    }

    .d-code .line {
      padding: 0 0.35rem 0 0.35rem;
    }

    .d-code .line::before {
      margin-right: 0.6rem;
      width: 0.9rem;
    }

    .d-run {
      font-size: 0.66rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .d-code .line,
    .d-steps i {
      transition: none;
    }

    .caret {
      display: none;
    }
  }
</style>
