---
import fs from "node:fs";
import path from "node:path";
import { presets, resolve, treeRows, pathKeys, segments, codeLines } from "./router";

const rows = treeRows();
const initial = presets[0];
const result = resolve(initial);
const lit = new Set(result.winner ? pathKeys(result.winner.route.pattern) : [""]);
const captured = Object.fromEntries(result.winner?.params ?? []);

// The release shown in the hero comes from version.go, so it cannot drift.
const versionFile = path.resolve(process.cwd(), "../version.go");
const version = fs.readFileSync(versionFile, "utf8").match(/const Version = "([^"]+)"/)?.[1];
if (!version) throw new Error(`No Version constant in ${versionFile}`);
---

<section class="lead">
  <div class="intro">
    <p class="meta">
      <span class="tile" aria-hidden="true"><b>30</b>Zn</span>
      <span>v{version}</span><i></i><span>MIT</span><i></i><span>Go 1.25+</span>
    </p>
    <h1>Galvanize <code>net/http</code>.</h1>
    <p class="lede">
      The high-performance, minimalist web layer for Go. Routing, binding, errors, and 29 middleware,
      applied as a thin coat over the standard library you already trust.
    </p>
    <div class="actions">
      <a class="btn primary" href="/guide/quickstart/">Get started</a>
      <a class="btn" href="https://github.com/0mjs/zinc">GitHub</a>
    </div>
    <button class="install" type="button" data-copy="go get github.com/0mjs/zinc">
      <span class="prompt">$</span>
      <code>go get github.com/0mjs/zinc</code>
      <span class="copy" data-copy-label>Copy</span>
    </button>
  </div>

  <div class="router" data-router>
    <div class="r-head">
      <span class="r-title">Router</span>
      <span class="r-hint" data-hint>Edit the path, or pick an example</span>
    </div>

    <label class="r-request">
      <span class="method">GET</span>
      <input type="text" value={initial} placeholder="/users/42" spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="Request path to match" data-path />
      <span class="caret" aria-hidden="true"></span>
      <span class="verdict" data-verdict data-ok={result.winner ? "true" : "false"}>{result.winner ? "200" : "404"}</span>
    </label>

    <!-- Every preset is laid out invisibly in the same cell, so the ruler and
         the code below are always as tall as the tallest example. -->
    <div class="slot">
      {presets.map((p) => (
        <ol class="ruler ghost" aria-hidden="true">
          {segments(resolve(p)).map((g) => <li data-kind={g.kind}><span class="text">{g.text}</span><span class="label">{g.label}</span></li>)}
        </ol>
      ))}
      <ol class="ruler" aria-label="How the path splits into segments" data-ruler>
        {segments(result).map((g) => (
          <li data-kind={g.kind}><span class="text">{g.text}</span><span class="label">{g.label}</span></li>
        ))}
      </ol>
    </div>

    <ol class="tree" aria-label="Registered routes as a tree">
      {rows.map((r) => (
        <li data-key={r.key} data-kind={r.kind} data-lit={lit.has(r.key) ? "" : undefined} data-name={r.name}>
          <span class="guide" aria-hidden="true">{r.guide}</span>
          <span class="seg">{r.seg}</span>
          <span class="cap" data-cap>{r.name && lit.has(r.key) && captured[r.name] !== undefined ? ` = "${captured[r.name]}"` : ""}</span>
          {r.handler && <span class="handler">{r.handler}</span>}
        </li>
      ))}
    </ol>

    <div class="slot r-code">
      {presets.map((p) => (
        <pre class="code ghost" aria-hidden="true">{codeLines(resolve(p)).map((line) => (
          <span class="line">{line.map(([t, c]) => <span class={`t-${c}`}>{t}</span>)}</span>
        ))}</pre>
      ))}
      <pre class="code" aria-live="polite" data-code>{codeLines(result).map((line) => (
        <span class="line">{line.map(([t, c]) => <span class={`t-${c}`}>{t}</span>)}</span>
      ))}</pre>
    </div>

    <div class="r-presets" role="group" aria-label="Example paths">
      {presets.map((p) => <button type="button" data-preset={p} aria-pressed={p === initial ? "true" : "false"}>{p}</button>)}
    </div>
  </div>
</section>

<script>
  import { resolve, pathKeys, presets, segments, codeLines } from "./router";

  document.querySelectorAll<HTMLButtonElement>(".lead .install").forEach((button) => {
    button.addEventListener("click", async () => {
      const label = button.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(button.dataset.copy || "");
        if (label) label.textContent = "Copied";
      } catch {
        const range = document.createRange();
        range.selectNodeContents(button.querySelector("code")!);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        if (label) label.textContent = "Selected";
      }
      setTimeout(() => label && (label.textContent = "Copy"), 1400);
    });
  });

  const STEP = 90; // ms between tree levels as a request descends

  document.querySelectorAll<HTMLElement>("[data-router]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("[data-path]")!;
    const verdict = root.querySelector<HTMLElement>("[data-verdict]")!;
    const ruler = root.querySelector<HTMLElement>("[data-ruler]")!;
    const code = root.querySelector<HTMLElement>("[data-code]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const nodes = [...root.querySelectorAll<HTMLElement>("li[data-key]")];
    const presetButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-preset]")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const el = (tag: string, cls: string, text = "") => {
      const e = document.createElement(tag);
      e.className = cls;
      e.textContent = text;
      return e;
    };

    const render = () => {
      const result = resolve(input.value);
      const w = result.winner;
      const path = w ? pathKeys(w.route.pattern) : [""];
      const captured = new Map(w?.params ?? []);
      const lost = new Set(result.others.flatMap((o) => pathKeys(o.route.pattern)));

      for (const n of nodes) {
        const key = n.dataset.key!;
        const i = path.indexOf(key);
        n.style.setProperty("--d", i >= 0 ? `${i * STEP}ms` : "0ms");
        n.toggleAttribute("data-lit", i >= 0);
        n.toggleAttribute("data-lost", i < 0 && lost.has(key));
        n.toggleAttribute("data-win", !!w && key === path[path.length - 1]);
        const name = n.dataset.name;
        n.querySelector<HTMLElement>("[data-cap]")!.textContent =
          i >= 0 && name && captured.has(name) ? ` = "${captured.get(name)}"` : "";
      }

      verdict.textContent = w ? "200" : "404";
      verdict.dataset.ok = String(Boolean(w));
      ruler.replaceChildren(
        ...segments(result).map((g) => {
          const li = document.createElement("li");
          li.dataset.kind = g.kind;
          li.append(el("span", "text", g.text), el("span", "label", g.label));
          return li;
        }),
      );
      code.replaceChildren(
        ...codeLines(result).map((line) => {
          const span = el("span", "line");
          span.append(...line.map(([t, c]) => el("span", `t-${c}`, t)));
          return span;
        }),
      );
      presetButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.preset === input.value)));
    };

    // Idle demo: type through the examples until someone interacts.
    let demo = !reduced;
    let timer = 0;
    const stopDemo = () => {
      if (!demo) return;
      demo = false;
      clearTimeout(timer);
      root.classList.remove("typing");
      hint.textContent = "Your turn: edit the path";
    };
    const typeOut = (text: string, done: () => void) => {
      let i = 0;
      input.value = "";
      root.classList.add("typing");
      const tick = () => {
        if (!demo) return;
        input.value = text.slice(0, ++i);
        if (i < text.length) timer = window.setTimeout(tick, 42 + Math.random() * 40);
        else { root.classList.remove("typing"); render(); timer = window.setTimeout(done, 3200); }
      };
      timer = window.setTimeout(tick, 250);
    };
    let next = 1;
    const loop = () => { if (!demo) return; typeOut(presets[next], () => { next = (next + 1) % presets.length; loop(); }); };

    input.addEventListener("input", () => { stopDemo(); render(); });
    input.addEventListener("focus", () => input.select());
    for (const ev of ["pointerdown", "keydown", "focusin"]) root.addEventListener(ev, stopDemo);
    presetButtons.forEach((b) => b.addEventListener("click", () => { stopDemo(); input.value = b.dataset.preset || "/"; render(); }));

    render();
    if (demo) {
      hint.textContent = "Playing examples · click to take over";
      const seen = new IntersectionObserver((entries) => {
        if (!demo) return seen.disconnect();
        if (entries[0].isIntersecting) timer = window.setTimeout(loop, 2400);
        else clearTimeout(timer);
      });
      seen.observe(root);
    }
  });
</script>

<style>
  .lead {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 4.5rem) 1rem;
  }

  .meta {
    align-items: center;
    color: var(--z-muted);
    display: flex;
    flex-wrap: wrap;
    font: 500 0.72rem/1 var(--sl-font-mono);
    gap: 0.7rem;
    letter-spacing: 0.04em;
    margin: 0 0 1.6rem;
  }

  .meta i {
    background: var(--sl-color-hairline-light);
    height: 0.9rem;
    width: 1px;
  }

  .tile {
    background: #c9ced3 url("/zn-spangle-hd.webp") center / cover;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.35), 0 0 0 1px var(--sl-color-hairline-light);
    color: #1e2226;
    display: grid;
    font: 400 0.95rem/1 var(--z-font-display);
    height: 2.6rem;
    margin-right: 0.35rem;
    place-items: end center;
    padding-bottom: 0.45rem;
    position: relative;
    width: 2.6rem;
  }

  .tile b {
    font: 500 0.5rem/1 var(--sl-font-mono);
    left: 0.3rem;
    position: absolute;
    top: 0.25rem;
  }

  /* One colour, a calmer size. net/http is set as code because it is code. */
  h1 {
    color: var(--z-text);
    font: 600 clamp(2.3rem, 4.2vw, 3.25rem) / 1.05 var(--sl-font);
    letter-spacing: -0.042em;
    margin: 0;
    text-wrap: balance;
  }

  h1 code {
    background: none;
    border: 0;
    color: inherit;
    font: 500 0.9em / 1 var(--sl-font-mono);
    letter-spacing: -0.045em;
    padding: 0;
  }

  .lede {
    color: var(--z-muted);
    font-size: 1.08rem;
    line-height: 1.6;
    margin: 1.25rem 0 1.9rem;
    max-width: 46ch;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    align-items: center;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--z-radius);
    color: var(--z-text);
    display: inline-flex;
    font-size: 0.92rem;
    font-weight: 600;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    text-decoration: none;
    transition: background 140ms ease, border-color 140ms ease;
  }

  .btn:hover {
    background: var(--z-zn-soft);
    border-color: var(--z-muted);
  }

  .btn.primary {
    background: var(--z-text);
    border-color: var(--z-text);
    color: var(--sl-color-bg);
  }

  .btn.primary:hover {
    background: var(--z-zn);
    border-color: var(--z-zn);
  }

  .install {
    align-items: center;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--z-body);
    cursor: pointer;
    display: flex;
    font: 400 0.82rem/1 var(--sl-font-mono);
    gap: 0.7rem;
    margin-top: 2rem;
    max-width: 30rem;
    padding: 1.1rem 0 0;
    text-align: left;
    width: 100%;
  }

  .install code {
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 0;
  }

  .install .prompt,
  .install .copy {
    color: var(--z-soft);
  }

  .install .copy {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    margin-left: auto;
    text-transform: uppercase;
  }

  .install:hover .copy {
    color: var(--z-text);
  }

  /* Route tree: a dark plate, like the code blocks. */
  .router {
    --lit: #88c0d0;
    --guide: #353b44;
    --rule: #1f242a; /* the plate is dark in both themes, so its rules are fixed too */
    background: var(--z-plate);
    border: 1px solid var(--rule);
    border-radius: 10px;
    color: var(--z-plate-ink);
    font-family: var(--sl-font-mono);
    overflow: hidden;
  }

  .r-head {
    align-items: center;
    background: var(--z-plate-bar);
    border-bottom: 1px solid var(--rule);
    display: flex;
    font-size: 0.72rem;
    justify-content: space-between;
    padding: 0.7rem 1.1rem;
  }

  .r-hint {
    color: var(--z-plate-mute);
  }

  /* The request bar looks like a field you can type in, because it is one. */
  .r-request {
    align-items: center;
    background: #0a0c0f;
    border: 1px solid #2c323a;
    border-radius: 8px;
    cursor: text;
    display: flex;
    gap: 0.75rem;
    margin: 0.9rem 1.1rem 0;
    padding: 0.55rem 0.55rem 0.55rem 0.8rem;
    position: relative;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  .r-request:hover {
    border-color: #3a424c;
  }

  .method {
    color: var(--z-code-kw);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .r-request input {
    background: transparent;
    border: 0;
    caret-color: var(--lit);
    color: #eceff4;
    flex: 1;
    font: 400 1rem/1.4 var(--sl-font-mono);
    min-width: 0;
    outline: none;
    padding: 0;
  }

  .r-request input::placeholder {
    color: #4c5561;
  }

  .r-request:focus-within {
    border-color: var(--lit);
    box-shadow: 0 0 0 3px rgba(136, 192, 208, 0.14);
  }

  .verdict {
    border: 1px solid rgba(163, 190, 140, 0.35);
    border-radius: 5px;
    color: var(--z-code-str);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.45rem;
  }

  .verdict[data-ok="false"] {
    border-color: rgba(208, 135, 112, 0.4);
    color: #d08770;
  }

  /* The path, cut into the segments the router compares. */
  .ruler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0.6rem 1.1rem 0.2rem;
  }

  /* Stack the live content on its invisible presets; the cell takes the
     height of the tallest, at whatever width the panel has. */
  .slot {
    display: grid;
  }

  .slot > * {
    grid-area: 1 / 1;
  }

  .ghost {
    visibility: hidden;
  }

  .ruler :global(li) {
    border-top: 2px solid #39414b;
    display: grid;
    gap: 0.25rem;
    margin: 0;
    min-width: 2.2rem;
    padding: 0.35rem 0.5rem 0 0;
  }

  .ruler :global(.text) {
    color: #d8dee9;
    font-size: 0.78rem;
  }

  .ruler :global(.label) {
    color: #5f6a79;
    font-size: 0.64rem;
  }

  .ruler :global(li[data-kind="static"]) {
    border-color: #7d889a;
  }

  .ruler :global(li[data-kind="param"]) {
    border-color: var(--lit);
  }

  .ruler :global(li[data-kind="param"]) :global(.label) {
    color: var(--lit);
  }

  .ruler :global(li[data-kind="catchall"]) {
    border-color: var(--z-code-num);
  }

  .ruler :global(li[data-kind="catchall"]) :global(.label) {
    color: var(--z-code-num);
  }

  .ruler :global(li[data-kind="none"]) {
    border-color: rgba(208, 135, 112, 0.55);
  }

  .ruler :global(li[data-kind="none"]) :global(.text) {
    color: #9aa4b2;
  }

  /* A block caret shown while the demo types, since the input is not focused. */
  .caret {
    display: none;
  }

  .typing .caret {
    animation: blink 900ms steps(1) infinite;
    background: var(--lit);
    display: block;
    height: 1.05rem;
    width: 0.45rem;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tree {
    font-size: 0.8rem;
    line-height: 1;
    list-style: none;
    margin: 0;
    padding: 0.75rem 0;
  }

  .tree li {
    align-items: center;
    display: flex;
    margin: 0;
    padding: 0.36rem 1.1rem;
    position: relative;
    white-space: pre;
  }

  .tree li::before {
    background: rgba(136, 192, 208, 0.07);
    content: "";
    inset: 0;
    opacity: 0;
    position: absolute;
    transition: opacity 240ms ease var(--d, 0ms);
  }

  .guide {
    color: var(--guide);
    transition: color 240ms ease var(--d, 0ms);
  }

  .seg {
    color: #7d889a;
    transition: color 240ms ease var(--d, 0ms);
  }

  li[data-kind="param"] .seg {
    color: #6d9aa6;
  }

  li[data-kind="catchall"] .seg {
    color: #8f7b99;
  }

  .cap {
    color: var(--z-code-str);
    opacity: 0;
    transition: opacity 240ms ease var(--d, 0ms);
  }

  .handler {
    align-items: center;
    color: #5f6a79;
    display: inline-flex;
    font-size: 0.72rem;
    gap: 0.5rem;
    margin-left: auto;
    padding-left: 1rem;
    transition: color 240ms ease var(--d, 0ms);
  }

  /* The request's path through the tree. */
  li[data-lit] .guide {
    color: var(--lit);
  }

  li[data-lit] .seg {
    color: #eceff4;
  }

  li[data-lit][data-kind="param"] .seg {
    color: var(--lit);
  }

  li[data-lit][data-kind="catchall"] .seg {
    color: var(--z-code-num);
  }

  li[data-lit] .cap {
    opacity: 1;
  }

  li[data-win]::before {
    opacity: 1;
  }

  li[data-win] .handler {
    color: #eceff4;
  }

  /* Routes that also matched but lost on precedence. */
  li[data-lost] .seg {
    color: #9aa4b2;
    text-decoration: line-through;
    text-decoration-color: #5b6470;
  }

  /* The Go that produces this result. It updates instantly. */
  .r-code {
    border-top: 1px solid var(--rule);
    padding: 0.8rem 1.1rem;
  }

  .code {
    align-content: start;
    background: transparent;
    border: 0;
    border-radius: 0;
    display: grid;
    font: var(--z-code-weight) 0.76rem/1.65 var(--sl-font-mono);
    margin: 0;
    overflow: visible;
    padding: 0;
  }

  .r-code :global(.line) {
    white-space: pre-wrap;
  }

  .r-code :global(.t-id) { color: #d8dee9; }
  .r-code :global(.t-fn) { color: #88c0d0; }
  .r-code :global(.t-str) { color: #a3be8c; }
  .r-code :global(.t-pn) { color: #7d889a; }
  .r-code :global(.t-cm) { color: #6c788e; }

  .r-presets {
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.8rem 1.1rem 0.9rem;
  }

  .r-presets button {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--z-plate-mute);
    cursor: pointer;
    font: 400 0.68rem/1 var(--sl-font-mono);
    padding: 0.4rem 0.65rem;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .r-presets button:hover,
  .r-presets button[aria-pressed="true"] {
    border-color: #3a414b;
    color: var(--z-plate-ink);
  }

  @media (max-width: 60rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tree li::before,
    .guide,
    .seg,
    .cap,
    .handler {
      transition: none;
    }

  }
</style>
