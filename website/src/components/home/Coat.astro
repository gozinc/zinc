---
// Cross-section of a galvanized stack: your code, a thin Zinc coat, net/http steel.
import { Code } from "astro:components";
import zincFrost from "../../themes/zinc-frost.json";

const contracts = [
  { part: "server", code: "server.Handler = app", note: "Run it on a server you configure" },
  { part: "handler", code: 'app.HandleHTTP("GET /metrics", promhttp.Handler())', note: "Serve a route with any standard handler" },
  { part: "middleware", code: "app.UseHTTP(otelhttp.NewMiddleware(\"api\"))", note: "Wrap the app in standard middleware" },
];
---

<section class="coat" data-coat>
  <div class="copy">
    <p class="kicker">How it fits</p>
    <h2>A thin coat, not a new engine.</h2>
    <p>
      Galvanizing protects steel without replacing it. Zinc does the same for <code>net/http</code>:
      your app is still an <code>http.Handler</code>, and standard handlers, middleware, and servers
      plug straight in.
    </p>
    <p class="pick">Pick one to see where it plugs into the stack.</p>
    <ul class="contracts" role="tablist" aria-label="Ways standard net/http code plugs into Zinc" data-contracts>
      {contracts.map((c, i) => (
        <li role="tab" data-link={c.part} aria-selected={String(i === 0)} tabindex={i === 0 ? "0" : "-1"}>
          <span class="note"><b class="num" aria-hidden="true">{i + 1}</b>{c.note}</span>
          <div class="snippet"><Code code={c.code} lang="go" theme={zincFrost as any} /></div>
        </li>
      ))}
    </ul>
    <a class="more" href="/guide/http-interoperability/">Zinc and net/http →</a>
  </div>

  <figure class="section-cut" data-cut data-focus="server" aria-label="Cross-section: your handlers sit on a thin Zinc coat, over standard middleware and net/http">
    <header class="cut-head">
      <span>Section A–A</span>
      <span>request ↑ · response ↓</span>
    </header>

    <div class="layer app">
      <div class="label">
        <strong>Your application</strong>
        <span>handlers · services · packages</span>
      </div>
      <div class="parts">
        <span class="part">listUsers</span>
        <span class="part">createUser</span>
        <span class="part std" data-part="handler"><b class="pin" aria-hidden="true">2</b>promhttp.Handler()</span>
      </div>
      <p class="legend">
        <span><i aria-hidden="true"></i>zinc.HandlerFunc</span>
        <span><i class="std" aria-hidden="true"></i>http.Handler</span>
      </p>
    </div>

    <div class="layer zn">
      <strong>Zinc</strong>
      <span>routing · binding · errors · middleware</span>
    </div>

    <div class="layer mw" data-part="middleware">
      <strong><b class="pin" aria-hidden="true">3</b>Standard middleware</strong>
      <span>otelhttp · func(http.Handler) http.Handler</span>
    </div>

    <div class="layer steel">
      <div class="label">
        <strong>net/http</strong>
        <span>the standard library, untouched</span>
      </div>
      <div class="parts">
        <span class="part metal" data-part="server"><b class="pin" aria-hidden="true">1</b>http.Server&#123;Handler: app&#125;</span>
        <span class="part metal">*http.Request</span>
        <span class="part metal">http.ResponseWriter</span>
      </div>
    </div>

    <figcaption>
      <span>http.Handler in</span>
      <span>http.Handler out</span>
    </figcaption>
  </figure>
</section>

<script>
  // Each contract is a tab: the selected one stays highlighted in the cut, and
  // hovering another previews it without changing the selection.
  document.querySelectorAll<HTMLElement>("[data-coat]").forEach((root) => {
    const cut = root.querySelector<HTMLElement>("[data-cut]")!;
    const tabs = [...root.querySelectorAll<HTMLElement>("[data-link]")];
    let selected = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");

    const show = (i: number) => (cut.dataset.focus = tabs[i].dataset.link);
    const select = (i: number, focus = false) => {
      selected = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", String(j === selected));
        t.tabIndex = j === selected ? 0 : -1;
      });
      show(selected);
      if (focus) tabs[selected].focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("pointerenter", () => show(i));
      t.addEventListener("pointerleave", () => show(selected));
      t.addEventListener("keydown", (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step) {
          e.preventDefault();
          select(selected + step, true);
        } else if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          select(i);
        }
      });
    });
  });
</script>

<style>
  .coat {
    align-items: stretch;
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  h2 {
    color: var(--z-text);
    font: 600 clamp(1.9rem, 3.4vw, 2.6rem) / 1.08 var(--sl-font);
    letter-spacing: -0.035em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }

  .copy > p:not(.kicker) {
    color: var(--z-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1.75rem;
    max-width: 46ch;
  }

  .copy code {
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--z-radius-sm);
    color: var(--z-text);
    font: 400 0.84em var(--sl-font-mono);
    padding: 0.05em 0.35em;
  }

  .contracts {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
  }

  .contracts li {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }

  .note {
    color: var(--z-muted);
    font-size: 0.85rem;
  }

  /* One-line code plates, the same dark finish as every code block. */
  .snippet {
    background: var(--z-plate);
    border: 1px solid #252a31;
    border-radius: 8px;
    overflow: hidden;
  }

  .snippet :global(.astro-code) {
    background: var(--z-plate) !important;
    border: 0;
    border-radius: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    overflow-x: auto;
    padding: 0.7rem 0.95rem;
    scrollbar-width: none;
  }

  .more {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    color: var(--z-zn);
  }

  .copy > p.pick {
    color: var(--z-soft);
    font: 400 0.72rem/1 var(--sl-font-mono);
    margin: 0 0 0.9rem;
    max-width: none;
  }

  .contracts li {
    border: 1px solid transparent;
    border-radius: 10px;
    cursor: pointer;
    margin-inline: -0.7rem;
    outline: none;
    padding: 0.6rem 0.7rem 0.7rem;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .contracts li:hover {
    background: color-mix(in srgb, var(--z-panel) 60%, transparent);
  }

  .contracts li[aria-selected="true"] {
    background: var(--z-panel);
    border-color: var(--sl-color-hairline-light);
  }

  .contracts li:focus-visible {
    border-color: var(--z-muted);
  }

  .note {
    align-items: center;
    display: flex;
    gap: 0.55rem;
  }

  .contracts li[aria-selected="true"] .note {
    color: var(--z-text);
  }

  /* The same numbered marker sits on the contract and on the part it plugs
     into, so the link is visible before anyone interacts. */
  .num,
  .pin {
    align-items: center;
    border: 1px solid currentColor;
    border-radius: 999px;
    display: inline-flex;
    flex: none;
    font: 600 0.62rem/1 var(--sl-font-mono);
    height: 1.15rem;
    justify-content: center;
    opacity: 0.7;
    transition: background-color 160ms ease, color 160ms ease, opacity 160ms ease;
    width: 1.15rem;
  }

  .pin {
    margin-right: 0.5rem;
    vertical-align: -0.1em;
  }

  .contracts li[aria-selected="true"] .num,
  .section-cut[data-focus="server"] [data-part="server"] .pin,
  .section-cut[data-focus="handler"] [data-part="handler"] .pin,
  .section-cut[data-focus="middleware"] .mw .pin {
    background: #c3ccd6; /* zinc, the same in both themes */
    border-color: #8e99a6;
    color: #16191c;
    opacity: 1;
  }

  /* The cut, drawn like a section drawing: each material has its own fill. */
  .section-cut {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
  }

  .cut-head,
  figcaption {
    background: var(--z-panel);
    color: var(--z-muted);
    display: flex;
    font: 400 0.7rem/1 var(--sl-font-mono);
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
  }

  .cut-head {
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  figcaption {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .layer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    justify-content: space-between;
    padding: 0 1.25rem;
    transition: opacity 200ms ease;
  }

  .layer strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .layer span {
    font: 400 0.72rem/1.3 var(--sl-font-mono);
  }

  .label {
    display: grid;
    gap: 0.3rem;
  }

  .app,
  .steel {
    align-content: space-between;
    flex: 1;
    min-height: 11rem;
    padding-block: 1.25rem;
  }

  .app {
    background:
      repeating-linear-gradient(90deg, transparent 0 23px, var(--sl-color-hairline) 23px 24px),
      var(--z-panel);
    color: var(--z-text);
  }

  .app .label span {
    color: var(--z-muted);
  }

  .parts {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .layer .part {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 6px;
    color: var(--z-text);
    font: 400 0.76rem/1 var(--sl-font-mono);
    padding: 0.55rem 0.7rem;
    transition: opacity 200ms ease, box-shadow 200ms ease;
  }

  /* A standard handler is made of the same steel as net/http. */
  .layer .part.std,
  .legend i.std {
    background: linear-gradient(180deg, #3a4047, #2a2f35);
    border-color: #4a525b;
    color: #e2e6ea;
  }

  .legend {
    display: flex;
    flex-basis: 100%;
    gap: 1.1rem;
    margin: 0;
  }

  .legend span {
    align-items: center;
    color: var(--z-soft);
    display: inline-flex;
    gap: 0.45rem;
  }

  .legend i {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 3px;
    height: 0.7rem;
    width: 0.7rem;
  }

  .zn {
    background: #c9ced3 url("/zn-spangle-wide.webp") center / cover no-repeat;
    border-block: 1px solid rgba(0, 0, 0, 0.35);
    color: #16191c;
    min-height: 3rem;
    padding-block: 0.6rem;
  }

  .zn strong {
    font: 400 0.82rem/1 var(--z-font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .zn span {
    color: #2d3238;
  }

  /* Standard middleware: steel again, hatched as a separate part. */
  .mw {
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 7px),
      #30353c;
    border-bottom: 1px solid #1a1d21;
    color: #e2e6ea;
    min-height: 3rem;
    padding-block: 0.6rem;
  }

  .mw strong {
    font-size: 0.85rem;
  }

  .mw span {
    color: #aab3bd;
  }

  /* Brushed steel: fine horizontal grain, no highlights. */
  .steel {
    align-content: center;
    row-gap: 1.1rem;
    background:
      repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, #2b3036, #1c2024);
    color: #e2e6ea;
  }

  .steel .label span {
    color: #9aa3ad;
  }

  .layer .part.metal {
    background: rgba(255, 255, 255, 0.04);
    border-color: #3d444c;
    color: #d5dbe1;
  }

  /* The selected contract's part is ringed; the other parts step back. */
  .section-cut[data-focus] .part {
    opacity: 0.6;
  }

  .section-cut[data-focus="handler"] [data-part="handler"],
  .section-cut[data-focus="server"] [data-part="server"] {
    box-shadow: 0 0 0 2px #c3ccd6;
    opacity: 1;
  }

  .section-cut[data-focus="middleware"] .mw {
    box-shadow: inset 0 0 0 2px #c3ccd6;
  }

  @media (max-width: 60rem) {
    .coat {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
