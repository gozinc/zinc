---
// Cross-section of a galvanized stack: your code, a thin Zinc coat, net/http steel.
import { Code } from "astro:components";
import zincFrost from "../../themes/zinc-frost.json";

const contracts = [
  { part: "server", code: "server.Handler = app", note: "Run it on a server you configure" },
  { part: "handler", code: 'app.HandleHTTP("GET /metrics", promhttp.Handler())', note: "Serve a route with any standard handler" },
  { part: "middleware", code: "app.UseHTTP(otelhttp.NewMiddleware(\"api\"))", note: "Wrap the app in standard middleware" },
];
---

<section class="coat" data-coat>
  <div class="copy">
    <p class="kicker">How it fits</p>
    <h2>A thin coat, not a new engine.</h2>
    <p>
      Galvanizing protects steel without replacing it. Zinc does the same for <code>net/http</code>:
      your app is still an <code>http.Handler</code>, and standard handlers, middleware, and servers
      plug straight in.
    </p>
    <ul class="contracts">
      {contracts.map((c) => (
        <li data-link={c.part} tabindex="0">
          <span class="note">{c.note}</span>
          <div class="snippet"><Code code={c.code} lang="go" theme={zincFrost as any} /></div>
        </li>
      ))}
    </ul>
    <a class="more" href="/guide/http-interoperability/">Zinc and net/http →</a>
  </div>

  <figure class="section-cut" data-cut aria-label="Cross-section: your handlers sit on a thin Zinc coat, over standard middleware and net/http">
    <header class="cut-head">
      <span>Section A–A</span>
      <span>request ↑ · response ↓</span>
    </header>

    <div class="layer app">
      <div class="label">
        <strong>Your application</strong>
        <span>handlers · services · packages</span>
      </div>
      <div class="parts">
        <span class="part">listUsers</span>
        <span class="part">createUser</span>
        <span class="part std" data-part="handler">promhttp.Handler()</span>
      </div>
      <p class="legend">
        <span><i aria-hidden="true"></i>zinc.HandlerFunc</span>
        <span><i class="std" aria-hidden="true"></i>http.Handler</span>
      </p>
    </div>

    <div class="layer zn">
      <strong>Zinc</strong>
      <span>routing · binding · errors · middleware</span>
    </div>

    <div class="layer mw" data-part="middleware">
      <strong>Standard middleware</strong>
      <span>otelhttp · func(http.Handler) http.Handler</span>
    </div>

    <div class="layer steel">
      <div class="label">
        <strong>net/http</strong>
        <span>the standard library, untouched</span>
      </div>
      <div class="parts">
        <span class="part metal" data-part="server">http.Server&#123;Handler: app&#125;</span>
        <span class="part metal">*http.Request</span>
        <span class="part metal">http.ResponseWriter</span>
      </div>
    </div>

    <figcaption>
      <span>http.Handler in</span>
      <span>http.Handler out</span>
    </figcaption>
  </figure>
</section>

<script>
  // Point at a contract and the cut shows where it attaches.
  document.querySelectorAll<HTMLElement>("[data-coat]").forEach((root) => {
    const cut = root.querySelector<HTMLElement>("[data-cut]")!;
    root.querySelectorAll<HTMLElement>("[data-link]").forEach((li) => {
      const on = () => (cut.dataset.focus = li.dataset.link);
      const off = () => delete cut.dataset.focus;
      li.addEventListener("pointerenter", on);
      li.addEventListener("pointerleave", off);
      li.addEventListener("focusin", on);
      li.addEventListener("focusout", off);
    });
  });
</script>

<style>
  .coat {
    align-items: stretch;
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .kicker {
    color: var(--z-muted);
    font: 500 0.72rem/1 var(--sl-font-mono);
    letter-spacing: 0.04em;
    margin: 0 0 1rem;
  }

  h2 {
    color: var(--z-text);
    font: 600 clamp(1.9rem, 3.4vw, 2.6rem) / 1.08 var(--sl-font);
    letter-spacing: -0.035em;
    margin: 0 0 1.1rem;
    text-wrap: balance;
  }

  .copy > p:not(.kicker) {
    color: var(--z-muted);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 1.75rem;
    max-width: 46ch;
  }

  .copy code {
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--z-radius-sm);
    color: var(--z-text);
    font: 400 0.84em var(--sl-font-mono);
    padding: 0.05em 0.35em;
  }

  .contracts {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
  }

  .contracts li {
    display: grid;
    gap: 0.4rem;
    margin: 0;
  }

  .note {
    color: var(--z-muted);
    font-size: 0.85rem;
  }

  /* One-line code plates, the same dark finish as every code block. */
  .snippet {
    background: var(--z-plate);
    border: 1px solid #252a31;
    border-radius: 8px;
    overflow: hidden;
  }

  .snippet :global(.astro-code) {
    background: var(--z-plate) !important;
    border: 0;
    border-radius: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    overflow-x: auto;
    padding: 0.7rem 0.95rem;
    scrollbar-width: none;
  }

  .more {
    color: var(--z-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    color: var(--z-zn);
  }

  .contracts li {
    border-radius: 10px;
    cursor: default;
    margin-inline: -0.6rem;
    outline: none;
    padding: 0.5rem 0.6rem 0.6rem;
    transition: background-color 160ms ease;
  }

  .contracts li:hover,
  .contracts li:focus-visible {
    background: var(--z-panel);
  }

  .contracts li:hover .note,
  .contracts li:focus-visible .note {
    color: var(--z-text);
  }

  .contracts li:focus-visible {
    box-shadow: inset 0 0 0 1px var(--z-muted);
  }

  /* The cut, drawn like a section drawing: each material has its own fill. */
  .section-cut {
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
  }

  .cut-head,
  figcaption {
    background: var(--z-panel);
    color: var(--z-muted);
    display: flex;
    font: 400 0.7rem/1 var(--sl-font-mono);
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
  }

  .cut-head {
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  figcaption {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .layer {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    justify-content: space-between;
    padding: 0 1.25rem;
    transition: opacity 200ms ease;
  }

  .layer strong {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .layer span {
    font: 400 0.72rem/1.3 var(--sl-font-mono);
  }

  .label {
    display: grid;
    gap: 0.3rem;
  }

  .app,
  .steel {
    align-content: space-between;
    flex: 1;
    min-height: 11rem;
    padding-block: 1.25rem;
  }

  .app {
    background:
      repeating-linear-gradient(90deg, transparent 0 23px, var(--sl-color-hairline) 23px 24px),
      var(--z-panel);
    color: var(--z-text);
  }

  .app .label span {
    color: var(--z-muted);
  }

  .parts {
    display: flex;
    flex-basis: 100%;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .layer .part {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 6px;
    color: var(--z-text);
    font: 400 0.76rem/1 var(--sl-font-mono);
    padding: 0.55rem 0.7rem;
    transition: opacity 200ms ease, box-shadow 200ms ease;
  }

  /* A standard handler is made of the same steel as net/http. */
  .layer .part.std,
  .legend i.std {
    background: linear-gradient(180deg, #3a4047, #2a2f35);
    border-color: #4a525b;
    color: #e2e6ea;
  }

  .legend {
    display: flex;
    flex-basis: 100%;
    gap: 1.1rem;
    margin: 0;
  }

  .legend span {
    align-items: center;
    color: var(--z-soft);
    display: inline-flex;
    gap: 0.45rem;
  }

  .legend i {
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 3px;
    height: 0.7rem;
    width: 0.7rem;
  }

  .zn {
    background: #c9ced3 url("/zn-spangle-wide.webp") center / cover no-repeat;
    border-block: 1px solid rgba(0, 0, 0, 0.35);
    color: #16191c;
    min-height: 3rem;
    padding-block: 0.6rem;
  }

  .zn strong {
    font: 400 0.82rem/1 var(--z-font-display);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .zn span {
    color: #2d3238;
  }

  /* Standard middleware: steel again, hatched as a separate part. */
  .mw {
    background:
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 7px),
      #30353c;
    border-bottom: 1px solid #1a1d21;
    color: #e2e6ea;
    min-height: 3rem;
    padding-block: 0.6rem;
  }

  .mw strong {
    font-size: 0.85rem;
  }

  .mw span {
    color: #aab3bd;
  }

  /* Brushed steel: fine horizontal grain, no highlights. */
  .steel {
    align-content: center;
    row-gap: 1.1rem;
    background:
      repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, #2b3036, #1c2024);
    color: #e2e6ea;
  }

  .steel .label span {
    color: #9aa3ad;
  }

  .layer .part.metal {
    background: rgba(255, 255, 255, 0.04);
    border-color: #3d444c;
    color: #d5dbe1;
  }

  /* Focus: dim everything except the part the hovered contract names. */
  .section-cut[data-focus] .layer,
  .section-cut[data-focus] .part {
    opacity: 0.35;
  }

  .section-cut[data-focus="handler"] .app,
  .section-cut[data-focus="server"] .steel,
  .section-cut[data-focus="middleware"] .mw {
    opacity: 1;
  }

  .section-cut[data-focus="handler"] [data-part="handler"],
  .section-cut[data-focus="server"] [data-part="server"] {
    box-shadow: 0 0 0 2px var(--z-zn);
    opacity: 1;
  }

  .section-cut[data-focus="middleware"] .mw {
    box-shadow: inset 0 0 0 2px var(--z-zn);
  }

  .section-cut[data-focus="server"] .steel .label,
  .section-cut[data-focus="handler"] .app .label {
    opacity: 1;
  }

  @media (max-width: 60rem) {
    .coat {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
