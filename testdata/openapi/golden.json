  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "The error body Zinc's default error handler writes.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "format": "int32",
                "description": "The HTTP status."
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "description": "Invalid fields, by name, and what's wrong with each.",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object",
                "description": "Details added with HTTPError.Details."
              }
            },
            "required": [
              "status",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "OaConflict": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "OaCreatePetBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "OaOwner": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "OaPet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The pet's ID.",
            "examples": [
              7
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "type": "string",
            "enum": [
              "cat",
              "dog"
            ]
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OaOwner"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "owner"
        ]
      },
      "OaSort": {
        "type": "string",
        "enum": [
          "name",
          "age"
        ]
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "oauth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://id.example.com/token",
            "scopes": {
              "pets:write": "Change pets"
            }
          }
        }
      }
    }
