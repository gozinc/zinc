    "/pets/{id}/photo": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "caption": {
                    "type": "string"
                  },
                  "photo": {
                    "type": "string",
                    "contentMediaType": "application/octet-stream"
                  }
                },
                "required": [
                  "caption"
                ]
              }
            }
          }
        },
        "responses": {
